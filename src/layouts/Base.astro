---
import '../styles/global.css';
import { REPO_URL, clubs, href } from '../lib/data';

interface Props {
  title?: string;
  description?: string;
  /** Full-width pages (the /h/ communities) stretch the header to match. */
  wide?: boolean;
}

const { title, wide = false, description = 'Premier League fan hubs: vote on every refereeing call, rate every match and see how each fanbase sees it, backed by an open ledger of VAR decisions.' } = Astro.props;
const fullTitle = title ? `${title} · FootyVibe` : 'FootyVibe: Premier League fan hubs and the VAR ledger';
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const nav = [
  { label: 'Leaderboard', to: '/' },
  { label: '/h/', to: '/h/' },
  { label: 'Season', to: '/season/2026-27/' },
  { label: 'Incidents', to: '/incidents/' },
  { label: 'Officials', to: '/officials/' },
  { label: 'Clubs', to: '/clubs/' },
  { label: 'Method', to: '/method/' },
];
const active = (to: string) => (to === '/' ? path === '/' : path.startsWith(to));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#fbfbfa" />
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <script is:inline>
      try {
        if (localStorage.getItem('theme') === 'dark') document.documentElement.dataset.theme = 'dark';
      } catch {}
    </script>
  </head>
  <body class:list={{ wide }}>
    <header class="site-header">
      <div class="bar">
        <a href={href('/')} class="logo" aria-label="FootyVibe home">
          <span class="logo-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18">
              <path d="M8.5 5v14" stroke="#ff6b70" stroke-width="2.6" stroke-linecap="round"></path>
              <path d="M15.5 5v14" stroke="#d9f95c" stroke-width="2.6" stroke-linecap="round"></path>
            </svg>
          </span>
          <span class="logo-name">FootyVibe</span>
        </a>
        <nav aria-label="Main">
          <ul>
            {
              nav.map((n) => (
                <li>
                  <a href={href(n.to)} aria-current={active(n.to) ? 'page' : undefined}>
                    {n.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <div class="actions">
          <button class="theme" id="theme-toggle" type="button" aria-label="Toggle dark mode" title="Toggle dark mode">
            <svg class="sun" viewBox="0 0 24 24" width="18" height="18"><circle cx="12" cy="12" r="4.5"></circle><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"></path></svg>
            <svg class="moon" viewBox="0 0 24 24" width="18" height="18"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4 8.5 8.5 0 1 0 20 14.5z"></path></svg>
          </button>
          <a class="account" href={href('/account/')} data-account-link data-clubs={JSON.stringify(Object.fromEntries(clubs.map((c) => [c.id, { short: c.short, primary: c.primary, secondary: c.secondary }])))}>
            <span class="acc-chip" data-account-chip hidden></span>
            <span data-account-label>Sign up</span>
          </a>
          <a class="add" href={href('/contribute/')} aria-label="Log an incident"><span aria-hidden="true">+</span><span class="add-short">&nbsp;Log</span><span class="add-long">&nbsp;incident</span></a>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap foot">
        <div>
          <div class="display foot-title">FootyVibe<span class="dot">.</span></div>
          <p class="muted">
            Premier League fan hubs and an open, community-maintained record of officiating decisions. Every entry cites its
            sources. Verdicts come from the Premier League's Key Match Incidents panel or the referees' body wherever possible.
          </p>
        </div>
        <div class="foot-links">
          <a href={REPO_URL}>GitHub</a>
          <a href={href('/contribute/')}>Contribute</a>
          <a href={href('/method/')}>Methodology</a>
          <a href={href('/privacy/')}>Privacy &amp; house rules</a>
          <a href={`${REPO_URL}/issues/new?template=correction.yml`}>Report a mistake</a>
        </div>
        <p class="dim small">
          Not affiliated with the Premier League, PGMOL/Pro Ref or any club. Club colours are used for identification only.
          Code MIT · Data CC BY-SA 4.0.
        </p>
      </div>
    </footer>
    <script>
      import { clubColours, loadMe, type Member } from '../lib/session';

      // Header account button: "Sign up" for guests, club chip + username for members.
      const link = document.querySelector<HTMLElement>('[data-account-link]');
      const paintAccount = async (user: Member | null) => {
        if (!link) return;
        const label = link.querySelector<HTMLElement>('[data-account-label]')!;
        const chip = link.querySelector<HTMLElement>('[data-account-chip]')!;
        label.textContent = user ? user.username : 'Sign up';
        link.classList.toggle('signed-in', Boolean(user));
        chip.hidden = !user;
        if (user) {
          const c = user.club ? JSON.parse(link.dataset.clubs ?? '{}')[user.club] : null;
          chip.textContent = c ? c.short : '—';
          const col = c ? clubColours(c.primary, c.secondary) : null;
          chip.style.background = col ? col.fill : '';
          chip.style.color = col ? col.ink : '';
        }
      };
      loadMe().then((d) => paintAccount(d.user));
      document.addEventListener('cao:me', (e) => paintAccount((e as CustomEvent<Member | null>).detail));

      document.getElementById('theme-toggle')!.addEventListener('click', () => {
        const root = document.documentElement;
        const dark = root.dataset.theme !== 'dark';
        if (dark) root.dataset.theme = 'dark';
        else delete root.dataset.theme;
        try {
          localStorage.setItem('theme', dark ? 'dark' : 'light');
        } catch {}
      });
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 12px;
    z-index: 50;
    padding-inline: var(--gutter);
    margin-top: 12px;
    view-transition-name: site-header;
  }
  .bar {
    max-width: var(--max);
    transition: max-width 0.2s var(--ease);
    margin-inline: auto;
    display: flex;
    align-items: center;
    gap: 12px;
    height: 60px;
    padding: 0 8px 0 10px;
    border-radius: 999px;
    background: var(--header-bg);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
  }
  :global(body.wide) .bar {
    max-width: 1760px;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-right: 6px;
  }
  .logo-mark {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #111113;
  }
  :global([data-theme='dark']) .logo-mark {
    background: #26262c;
  }
  .logo-name {
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 700;
    letter-spacing: -0.03em;
    white-space: nowrap;
  }
  nav {
    margin-inline: auto;
  }
  nav ul {
    display: flex;
    gap: 2px;
    list-style: none;
    margin: 0;
    padding: 4px;
    border-radius: 999px;
    background: var(--pill);
  }
  nav a {
    display: block;
    padding: 7px 16px;
    border-radius: 999px;
    font-size: 14.5px;
    font-weight: 500;
    color: var(--muted);
    white-space: nowrap;
    transition:
      color 0.2s var(--ease),
      background 0.2s var(--ease);
  }
  nav a:hover {
    color: var(--text);
  }
  nav a[aria-current='page'] {
    background: var(--panel);
    color: var(--text);
    box-shadow: 0 1px 3px rgba(17, 17, 19, 0.1);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .theme {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 0;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition: background 0.2s var(--ease);
  }
  .theme:hover {
    background: var(--pill);
    color: var(--text);
  }
  .theme svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }
  .theme .sun {
    display: none;
  }
  :global([data-theme='dark']) .theme .sun {
    display: block;
  }
  :global([data-theme='dark']) .theme .moon {
    display: none;
  }
  .account {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 44px;
    padding: 0 16px;
    border-radius: 999px;
    border: 1px solid var(--line-2);
    background: var(--panel);
    font-size: 14.5px;
    font-weight: 600;
    white-space: nowrap;
    max-width: 180px;
  }
  .account span:last-child {
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .account:hover {
    background: var(--pill);
  }
  .account.signed-in {
    padding-left: 8px;
  }
  .acc-chip {
    display: inline-grid;
    place-items: center;
    min-width: 32px;
    height: 24px;
    padding: 0 5px;
    border-radius: 7px;
    background: var(--pill);
    color: var(--dim);
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 700;
  }
  .add {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 44px;
    padding: 0 18px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--on-ink);
    font-size: 14.5px;
    font-weight: 500;
    white-space: nowrap;
    transition: transform 0.2s var(--ease);
  }
  .add .add-long,
  .add .add-short {
    color: inherit;
    font-size: inherit;
  }
  .add span {
    color: var(--volt);
    font-size: 18px;
    line-height: 1;
  }
  :global([data-theme='dark']) .add span {
    color: #4f46e5;
  }
  .add:hover {
    transform: translateY(-1px);
  }
  @media (max-width: 1360px) {
    nav a {
      padding: 7px 12px;
    }
    .add .add-long {
      display: none;
    }
  }
  @media (max-width: 1120px) {
    .site-header {
      top: 8px;
      margin-top: 8px;
    }
    .bar {
      height: auto;
      flex-wrap: wrap;
      padding: 8px;
      border-radius: 26px;
      gap: 8px;
    }
    nav {
      order: 3;
      width: 100%;
      margin: 0;
      overflow-x: auto;
      scrollbar-width: none;
    }
    nav ul {
      width: max-content;
      min-width: 100%;
    }
    .actions {
      margin-left: auto;
    }
  }
  @media (max-width: 440px) {
    .logo-mark {
      width: 36px;
      height: 36px;
    }
    .logo-name {
      font-size: 16px;
    }
    .theme {
      width: 36px;
      height: 36px;
    }
    .add {
      height: 38px;
      padding: 0 14px;
      font-size: 13px;
    }
    .add .add-long {
      display: none;
    }
    .account {
      height: 38px;
      padding: 0 12px;
      font-size: 13px;
    }
    .account.signed-in {
      padding: 0 5px;
    }
    .account.signed-in span:last-child,
    .add .add-short {
      display: none;
    }
    .add {
      width: 38px;
      padding: 0;
      justify-content: center;
    }
    .actions {
      gap: 4px;
    }
  }
  .site-footer {
    margin-top: 56px;
    padding-block: 56px 40px;
    border-top: 1px solid var(--line);
  }
  .foot {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 20px 48px;
  }
  .foot-title {
    font-size: clamp(36px, 6vw, 72px);
  }
  .foot-title .dot {
    color: var(--brand);
  }
  .foot p {
    max-width: 58ch;
    font-size: 14.5px;
  }
  .foot-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    align-content: start;
    justify-content: end;
    font-size: 14.5px;
    color: var(--muted);
  }
  .foot-links a:hover {
    color: var(--text);
  }
  .small {
    font-size: 12.5px;
    grid-column: 1 / -1;
    margin: 16px 0 0;
    font-family: var(--font-mono);
  }
  @media (max-width: 720px) {
    .foot {
      grid-template-columns: minmax(0, 1fr);
    }
    .foot-links {
      justify-content: start;
    }
  }
</style>
