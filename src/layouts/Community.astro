---
// Reddit-style three columns for /h/: communities on the left, the feed or post in the middle, the community sidebar on the right.
import Base from './Base.astro';
import ClubBadge from '../components/ClubBadge.astro';
import { LEAGUE_SLUG, communities, href } from '../lib/data';

interface Props {
  title: string;
  description?: string;
  active: string;
}
const { title, description, active } = Astro.props;
const list = communities();
const resources = [
  ['Leaderboard', '/'],
  ['Season', '/season/2026-27/'],
  ['Incidents', '/incidents/'],
  ['Officials', '/officials/'],
  ['Method', '/method/'],
  ['Privacy & rules', '/privacy/'],
];
---

<Base title={title} description={description} wide>
  <div class="h-shell">
    <aside class="h-left" aria-label="Communities">
      <nav>
        <a class:list={['h-nav', { on: active === LEAGUE_SLUG }]} href={href(`/h/${LEAGUE_SLUG}/`)}>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6h-6v6H4a1 1 0 0 1-1-1z"></path></svg>
          Home
        </a>
        <a class="h-nav" href={href('/account/')} data-my-club hidden>
          <span class="h-mini" data-my-club-chip></span>
          <span data-my-club-label>Your club</span>
        </a>
      </nav>

      <h2 class="h-group">Communities</h2>
      <ul class="h-list">
        {
          list.map((c) => (
            <li>
              <a class:list={['h-comm', { on: active === c.slug }]} href={href(`/h/${c.slug}/`)} data-community={c.hub}>
                {c.club ? <ClubBadge id={c.club.id} size={26} /> : <span class="h-pl">PL</span>}
                <span>h/{c.slug}</span>
              </a>
            </li>
          ))
        }
      </ul>

      <h2 class="h-group">Resources</h2>
      <ul class="h-list">
        {
          resources.map(([label, to]) => (
            <li>
              <a class="h-res" href={href(to)}>
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </aside>

    <details class="h-switch">
      <summary>
        <span>h/{active}</span>
        <span class="dim">Communities ▾</span>
      </summary>
      <div class="h-switch-list">
        {
          list.map((c) => (
            <a class:list={['h-comm', { on: active === c.slug }]} href={href(`/h/${c.slug}/`)}>
              {c.club ? <ClubBadge id={c.club.id} size={22} /> : <span class="h-pl sm">PL</span>}
              <span>h/{c.slug}</span>
            </a>
          ))
        }
      </div>
    </details>

    <div class="h-main">
      <slot />
    </div>

    <aside class="h-right">
      <slot name="side" />
    </aside>
  </div>
</Base>

<script>
  import { loadMe } from '../lib/session';

  // "Your club" shortcut in the left rail, from the member's club or this device's saved one.
  const link = document.querySelector<HTMLAnchorElement>('[data-my-club]');
  const show = (clubId: string | null) => {
    if (!link || !clubId || clubId === 'none') return;
    const target = document.querySelector<HTMLAnchorElement>(`.h-left [data-community="${clubId}"]`);
    if (!target) return;
    link.href = target.href;
    link.querySelector('[data-my-club-label]')!.textContent = 'Your club';
    link.querySelector('[data-my-club-chip]')!.innerHTML = target.querySelector('.badge')?.outerHTML ?? '';
    link.classList.toggle('on', target.classList.contains('on'));
    link.hidden = false;
  };
  try {
    show(localStorage.getItem('cao-club'));
  } catch {}
  loadMe().then((d) => d.user && show(d.user.club));
</script>

<style>
  .h-shell {
    display: grid;
    grid-template-columns: clamp(232px, 15vw, 280px) minmax(0, 1fr) clamp(316px, 21vw, 380px);
    gap: clamp(24px, 2.2vw, 40px);
    max-width: 1760px;
    margin: 20px auto 0;
    padding-inline: var(--gutter);
    align-items: start;
  }
  .h-left {
    position: sticky;
    top: 88px;
    max-height: calc(100vh - 100px);
    overflow-y: auto;
    padding: 4px 10px 20px 0;
    border-right: 1px solid var(--line);
    scrollbar-width: thin;
  }
  .h-nav,
  .h-comm,
  .h-res {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px;
    border-radius: 10px;
    font-size: 14.5px;
    color: var(--text);
  }
  .h-nav svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linejoin: round;
  }
  .h-nav:hover,
  .h-comm:hover,
  .h-res:hover {
    background: var(--pill);
  }
  .h-nav.on,
  .h-comm.on {
    background: var(--pill-hover);
    font-weight: 600;
  }
  .h-mini {
    display: inline-flex;
  }
  .h-mini :global(.badge) {
    --size: 22px !important;
  }
  .h-group {
    margin: 18px 12px 6px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--dim);
  }
  .h-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .h-comm {
    padding: 6px 12px;
    font-size: 14px;
  }
  .h-res {
    font-size: 14px;
    color: var(--muted);
  }
  .h-pl {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: #37003c;
    color: #00ff85;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
  }
  .h-pl.sm {
    width: 22px;
    height: 22px;
    font-size: 9px;
  }
  .h-switch {
    display: none;
  }
  .h-main {
    min-width: 0;
  }
  .h-right {
    display: grid;
    gap: 14px;
    position: sticky;
    top: 88px;
  }
  @media (max-width: 1240px) {
    .h-shell {
      grid-template-columns: minmax(0, 1fr) 300px;
    }
    .h-left {
      display: none;
    }
    .h-switch {
      display: block;
      grid-column: 1 / -1;
      border: 1px solid var(--line);
      border-radius: 14px;
      background: var(--panel);
    }
    .h-switch summary {
      display: flex;
      justify-content: space-between;
      padding: 10px 14px;
      font-weight: 600;
      cursor: pointer;
      list-style: none;
    }
    .h-switch summary::-webkit-details-marker {
      display: none;
    }
    .h-switch-list {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
      gap: 2px;
      padding: 0 6px 8px;
    }
  }
  @media (max-width: 900px) {
    .h-shell {
      grid-template-columns: minmax(0, 1fr);
      gap: 14px;
    }
    .h-right {
      position: static;
    }
  }
</style>
