---
import Base from '../../layouts/Base.astro';
import ClubBadge from '../../components/ClubBadge.astro';
import Cited from '../../components/Cited.astro';
import Dot from '../../components/Dot.astro';
import FanHeat from '../../components/FanHeat.astro';
import FanVerdict from '../../components/FanVerdict.astro';
import LastFive from '../../components/LastFive.astro';
import Verdict from '../../components/Verdict.astro';
import {
  argumentPoll,
  postForPoll,
  postUrl,
  club,
  fanHeatByOfficial,
  formatDate,
  href,
  incidents,
  incidentsFor,
  matches,
  official,
  officialStats,
  pct,
  sentimentFiles,
  sentimentFor,
  unpacked,
  verdictOf,
  type Match,
} from '../../lib/data';

export function getStaticPaths() {
  return unpacked.map((u) => ({ params: { id: u.match } }));
}

const { id } = Astro.params;
const u = unpacked.find((x) => x.match === id)!;
const m = matches.find((x) => x.id === id)!;
const home = club(m.home);
const away = club(m.away);
const [hg, ag] = m.score.split('-').map(Number);
const keyIncidents = incidentsFor(m);
const incidentById = new Map(keyIncidents.map((i) => [i.id, i]));
const fans = sentimentFor(m);

// Citations are numbered in the order sources are listed.
const tz = (iso: string) =>
  iso.length === 10
    ? formatDate(iso)
    : new Date(iso).toLocaleString('en-GB', {
        timeZone: 'Europe/London',
        day: 'numeric',
        month: 'short',
        year: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
        timeZoneName: 'short',
      });
const sources = new Map(u.sources.map((s, n) => [s.id, { n: n + 1, label: `${s.publisher}: ${s.title}` }]));
const citedCount = [u.standfirst, u.bottomLine, u.timeline, u.decided.flatMap((d) => d.body), u.questions.flatMap((q) => q.a), u.arguments.flatMap((a) => [a.resolution, ...a.sides.flatMap((s) => s.points)])].flat();
const claims = citedCount.length;
const uncited = citedCount.filter((c) => c.cite.length === 0).length;

// ── Match Brief: only what was knowable before kick-off ─────────────────────
const before = (c: string) =>
  matches
    .filter((x) => x.season === m.season && [x.home, x.away].includes(c) && x.date < m.date)
    .map((x) => {
      const [h, a] = x.score.split('-').map(Number);
      const [f, ag2] = x.home === c ? [h, a] : [a, h];
      const r = f > ag2 ? 'W' : f === ag2 ? 'D' : 'L';
      return { x, r, f, a: ag2, opp: x.home === c ? x.away : x.home, venue: x.home === c ? 'H' : 'A' };
    });
const form = [m.home, m.away].map((c) => {
  const rows = before(c);
  return { club: club(c), rows, pts: rows.reduce((n, r) => n + (r.r === 'W' ? 3 : r.r === 'D' ? 1 : 0), 0), gf: rows.reduce((n, r) => n + r.f, 0), ga: rows.reduce((n, r) => n + r.a, 0) };
});
const lastMeetings = matches
  .filter((x) => [x.home, x.away].includes(m.home) && [x.home, x.away].includes(m.away) && x.date < m.date)
  .reverse()
  .slice(0, 3);

// ── Ref Watch ────────────────────────────────────────────────────────────────
const statsBefore = new Map(officialStats(incidents.filter((i) => i.date < m.date)).map((s) => [s.official.id, s]));
const statsNow = new Map(officialStats().map((s) => [s.official.id, s]));
const prevSeason = `${Number(m.season.slice(0, 4)) - 1}-${m.season.slice(2, 4)}`;
const heatPrev = new Map(fanHeatByOfficial(prevSeason).map((h) => [h.official.id, h]));
const withClubs = (oid: string) =>
  matches.filter((x) => x.date < m.date && Object.values(x.officials).includes(oid) && [x.home, x.away].some((c) => c === m.home || c === m.away));
const crew = (['referee', 'var', 'avar'] as const)
  .map((role) => ({ role, id: m.officials[role] }))
  .filter((c): c is { role: 'referee' | 'var' | 'avar'; id: string } => Boolean(c.id))
  .map(({ role, id: oid }) => {
    const b = statsBefore.get(oid);
    const now = statsNow.get(oid);
    const here = (now?.decisions ?? []).filter((d) => keyIncidents.includes(d.incident));
    const seasonApps = matches.filter((x) => x.season === m.season && x.date <= m.date && x.officials[role] === oid).length;
    return { role, o: official(oid), before: b, now, here, seasonApps, heat: heatPrev.get(oid), withClubs: withClubs(oid) };
  });
const roleName = { referee: 'Referee', var: 'VAR', avar: 'Assistant VAR' };

// ── Fan Pulse ────────────────────────────────────────────────────────────────
const seasonThreads = sentimentFiles.find((f) => f.season === m.season)?.threads ?? [];
const rank = fans ? [...seasonThreads].sort((a, b) => b.outrage - a.outrage).findIndex((t) => t.match === m.id) + 1 : 0;
const seasonAvg = seasonThreads.length ? Math.round(seasonThreads.reduce((n, t) => n + t.outrage, 0) / seasonThreads.length) : 0;
const splitTotal = fans ? fans.split.home + fans.split.away + fans.split.neutral : 0;
const share = (n: number) => Math.round((100 * n) / (splitTotal || 1));
const ordinal = (n: number) => `${n}${['th', 'st', 'nd', 'rd'][n % 100 > 10 && n % 100 < 14 ? 0 : n % 10] ?? 'th'}`;

const weightLabel = { decisive: 'Decisive', significant: 'Significant', contributing: 'Contributing' };
const title = `${home.short} ${hg}–${ag} ${away.short}: what actually decided it`;
const description = `${u.headline}. The full breakdown: the key calls, both sides of the argument, fan mood and every source.`;
const pageUrl = new URL(href(`/matches/${m.id}/`), Astro.site).toString();
const shareText = `${home.name} ${hg}–${ag} ${away.name}: ${u.headline}`;
const sections = [
  ['decided', 'What decided it'],
  ['timeline', 'Timeline'],
  ['arguments', 'Arguments'],
  ['fans', 'Fan Pulse'],
  ['refs', 'Ref Watch'],
  ['ask', 'Ask'],
  ['brief', 'Match Brief'],
  ['sources', 'Sources'],
];
const matchLine = (x: Match) => `${club(x.home).short} ${x.score.replace('-', '–')} ${club(x.away).short}`;
---

<Base title={title} description={description}>
  <article class="wrap unpacked">
    <a class="link-arrow back" href={href(`/season/${m.season}/`)}>← {m.season.replace('-', '–')} season</a>

    <header class="hero panel">
      <div class="hero-top">
        <span class="brand-chip"><span class="spark" aria-hidden="true"></span>Match Unpacked</span>
        {u.status !== 'published' && <span class="tag proto">Prototype</span>}
        <span class="tag">Premier League · MW{m.matchweek}</span>
        <span class="tag">{formatDate(m.date, { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' })} · {m.kickoff}</span>
      </div>

      <div class="scoreline">
        <a href={href(`/clubs/${home.id}/`)} class:list={['team', { lost: hg < ag }]}>
          <ClubBadge id={home.id} size={64} />
          <span class="team-name">{home.name}</span>
        </a>
        <div class="score display" aria-label={`${hg} to ${ag}`}>
          <span>{hg}</span><span class="dash">–</span><span>{ag}</span>
        </div>
        <a href={href(`/clubs/${away.id}/`)} class:list={['team', 'away', { lost: ag < hg }]}>
          <ClubBadge id={away.id} size={64} />
          <span class="team-name">{away.name}</span>
        </a>
      </div>

      <h1 class="display">{u.headline}</h1>
      <p class="standfirst"><Cited items={u.standfirst} sources={sources} /></p>

      <div class="hero-foot">
        <div class="receipts mono">
          <span><b>{claims}</b> claims</span>
          <span><b>{u.sources.length}</b> sources</span>
          <span><b>{claims - uncited}</b> cited</span>
          <span>updated {formatDate(u.updated)}</span>
        </div>
        <div class="share" data-url={pageUrl} data-text={shareText}>
          <button type="button" class="share-btn primary" data-share>
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M12 3v12M7 8l5-5 5 5M5 14v5a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-5"></path></svg>
            <span data-label>Share</span>
          </button>
          <a class="share-btn" target="_blank" rel="noopener" href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(shareText)}&url=${encodeURIComponent(pageUrl)}`}>X</a>
          <a class="share-btn" target="_blank" rel="noopener" href={`https://wa.me/?text=${encodeURIComponent(`${shareText} ${pageUrl}`)}`}>WhatsApp</a>
          <a class="share-btn" target="_blank" rel="noopener" href={`https://www.reddit.com/submit?url=${encodeURIComponent(pageUrl)}&title=${encodeURIComponent(shareText)}`}>Reddit</a>
        </div>
      </div>
    </header>

    <nav class="jump" aria-label="On this page">
      <ul>
        {sections.map(([to, label]) => <li><a href={`#${to}`}>{label}</a></li>)}
      </ul>
    </nav>

    <!-- What decided it -->
    <section id="decided" class="block-section">
      <div class="section-head">
        <div>
          <span class="eyebrow">Post-match report</span>
          <h2>What actually decided the game?</h2>
        </div>
      </div>
      <div class="factors">
        {
          u.decided.map((d, n) => {
            const inc = d.incident ? incidentById.get(d.incident) : undefined;
            return (
              <div class:list={['panel', 'factor', d.weight]}>
                <div class="factor-top">
                  <span class="factor-n mono">0{n + 1}</span>
                  <span class:list={['weight', d.weight]}>{weightLabel[d.weight]}</span>
                </div>
                <h3>{d.title}</h3>
                <p><Cited items={d.body} sources={sources} /></p>
                {inc && (
                  <a class="factor-link" href={href(`/incidents/${inc.id}/`)}>
                    <Verdict verdict={verdictOf(inc)} size="sm" />
                    <span>{inc.minute} · Case file →</span>
                  </a>
                )}
              </div>
            );
          })
        }
      </div>
      <p class="bottom-line"><b>Bottom line.</b> <Cited items={u.bottomLine} sources={sources} /></p>
    </section>

    <!-- Timeline -->
    <section id="timeline" class="block-section">
      <div class="section-head">
        <div>
          <span class="eyebrow">Timestamps</span>
          <h2>How it unfolded</h2>
          <p>Match events use the match clock. Everything after full time carries the publication time of its source.</p>
        </div>
      </div>
      <ol class="timeline panel">
        {
          u.timeline.map((t) => {
            const inc = t.incident ? incidentById.get(t.incident) : undefined;
            return (
              <li class:list={{ key: Boolean(inc) }}>
                <span class="clock mono">{t.clock}</span>
                <span class="rail" aria-hidden="true"><span /></span>
                <div class="t-body">
                  <p>
                    {inc && <Dot verdict={verdictOf(inc)} size={14} />} <Cited items={[t]} sources={sources} />
                  </p>
                  {t.at && <time class="dim mono" datetime={t.at}>{tz(t.at)}</time>}
                </div>
              </li>
            );
          })
        }
      </ol>
    </section>

    <!-- Arguments -->
    <section id="arguments" class="block-section">
      <div class="section-head">
        <div>
          <span class="eyebrow">Both sides, fairly</span>
          <h2>The arguments</h2>
          <p>The strongest case each way, taken from what officials, pundits and fans actually said. Then where it landed, and where you land.</p>
        </div>
      </div>
      <div class="debates">
        {
          u.arguments.map((a, n) => (
            <div class="panel debate">
              <h3>{a.question}</h3>
              <div class="sides">
                {a.sides.map((s, k) => (
                  <div class:list={['side', k === 0 ? 'for' : 'against']}>
                    <span class="side-label">{s.label}</span>
                    <ul>
                      {s.points.map((p) => (
                        <li>
                          <Cited items={[p]} sources={sources} />
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
              <div class="resolution">
                <Verdict verdict={a.resolution.verdict} size="sm" label={a.resolution.verdict === 'debatable' ? 'Unresolved' : 'Resolved'} />
                <span>
                  <Cited items={[a.resolution]} sources={sources} />
                </span>
              </div>
              <div class="debate-fans">
                <FanVerdict poll={argumentPoll(u, n)} showQuestion={false} discussHref={postUrl(postForPoll(argumentPoll(u, n).id)!)} />
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Fan Pulse -->
    {
      fans && (
        <section id="fans" class="block-section">
          <div class="section-head">
            <div>
              <span class="eyebrow">r/soccer post-match thread</span>
              <h2>Fan Pulse</h2>
              <p>
                How much of the thread was anger at the officiating, weighted by upvotes. A mood reading, not a verdict.{' '}
                <a href={href('/method/')}>How it's measured</a>
              </p>
            </div>
          </div>
          <div class="pulse">
            <div class="panel pulse-main">
              <div class="meter">
                <span class="meter-n display">{fans.outrage}</span>
                <div>
                  <FanHeat outrage={fans.outrage} showLabel />
                  <p class="dim">
                    {ordinal(rank)} angriest of {seasonThreads.length} threads this season · season average {seasonAvg}
                  </p>
                </div>
              </div>
              <dl class="pulse-stats">
                <div><dt>Comments read</dt><dd class="mono">{fans.comments.toLocaleString()}</dd></div>
                <div><dt>About officiating</dt><dd class="mono">{fans.officiating} <small>{pct(fans.officiating / fans.comments)}</small></dd></div>
                <div><dt>Angry about it</dt><dd class="mono neg">{fans.angry}</dd></div>
                <div><dt>Defending the refs</dt><dd class="mono pos">{fans.defending}</dd></div>
              </dl>
              <div class="split">
                <span class="split-title">Where the anger came from <span class="dim">(upvote-weighted, by user flair)</span></span>
                <div class="split-bar" role="img" aria-label={`${home.short} fans ${share(fans.split.home)}%, ${away.short} fans ${share(fans.split.away)}%, other fans ${share(fans.split.neutral)}%`}>
                  <span style={`width:${share(fans.split.home)}%;background:${home.primary}`} />
                  <span style={`width:${share(fans.split.away)}%;background:${away.primary}`} />
                  <span class="neutral" style={`width:${share(fans.split.neutral)}%`} />
                </div>
                <div class="split-key">
                  <span><i style={`background:${home.primary}`} />{home.short} fans {share(fans.split.home)}%</span>
                  <span><i style={`background:${away.primary}`} />{away.short} fans {share(fans.split.away)}%</span>
                  <span><i class="neutral" />Everyone else {share(fans.split.neutral)}%</span>
                </div>
                {share(fans.split.neutral) > 50 && (
                  <p class="insight">
                    Most of the anger came from people without a {home.short} or {away.short} flair. This wasn't just {home.short} fans being {home.short} fans.
                  </p>
                )}
              </div>
            </div>
            <div class="panel pulse-voices">
              <span class="eyebrow">Main gripes</span>
              <div class="topics">{fans.topics.map((t) => <span class="tag">{t}</span>)}</div>
              <span class="eyebrow voices-title">In their words</span>
              {fans.quotes.map((q) => (
                <blockquote>
                  “{q.text}”
                  <cite>
                    {q.fan ? `${club(q.fan).name} fan` : 'No club flair'}
                    {q.score > 1 && ` · ${q.score.toLocaleString()} upvotes`}
                  </cite>
                </blockquote>
              ))}
              <a class="thread-link" href={fans.thread.url} target="_blank" rel="noopener">
                Read the thread on r/soccer →
              </a>
            </div>
          </div>
        </section>
      )
    }

    <!-- Ref Watch -->
    <section id="refs" class="block-section">
      <div class="section-head">
        <div>
          <span class="eyebrow">Ref Watch</span>
          <h2>The officials</h2>
          <p>Their record on file going into this match, and what this game did to it.</p>
        </div>
        <a class="link-arrow" href={href('/officials/')}>Full leaderboard →</a>
      </div>
      <div class="crew">
        {
          crew.map((c) => (
            <a class="panel ref" href={href(`/officials/${c.o.id}/`)}>
              <div class="ref-top">
                <span class="eyebrow">{roleName[c.role]}</span>
                <span class="here">
                  {c.here.map((d) => (
                    <span class:list={['here-call', d.verdict]} title={d.incident.title}>
                      <Dot verdict={d.verdict} size={14} />
                      {d.incident.minute}
                    </span>
                  ))}
                </span>
              </div>
              <h3>{c.o.name}</h3>
              {c.o.note && <p class="ref-note">{c.o.note}</p>}
              <dl class="ref-stats">
                <div>
                  <dt>Accuracy before</dt>
                  <dd class="mono">{pct(c.before?.accuracy ?? null)}</dd>
                </div>
                <div>
                  <dt>Accuracy now</dt>
                  <dd class:list={['mono', { neg: (c.now?.accuracy ?? 0) < (c.before?.accuracy ?? 0) }]}>{pct(c.now?.accuracy ?? null)}</dd>
                </div>
                <div>
                  <dt>Errors on file</dt>
                  <dd class="mono">
                    {c.before?.errors ?? 0} → {c.now?.errors ?? 0}
                  </dd>
                </div>
                <div>
                  <dt>{m.season} as {roleName[c.role]}</dt>
                  <dd class="mono">{c.seasonApps} games</dd>
                </div>
              </dl>
              <div class="ref-form">
                <span class="dim">Last five judged calls</span>
                <LastFive decisions={c.now?.decisions ?? []} size={18} link={false} />
              </div>
              <p class="ref-foot dim">
                {c.withClubs.length} earlier games on file involving {home.short} or {away.short}
                {c.heat && ` · ${prevSeason} fan outrage avg ${Math.round(c.heat.avg)}`}
              </p>
            </a>
          ))
        }
      </div>
    </section>

    <!-- Match Room preview -->
    <section id="ask" class="block-section">
      <div class="section-head">
        <div>
          <span class="eyebrow">Match Room · preview</span>
          <h2>Ask this match</h2>
          <p>In the full product you could ask anything and get an answer with sources. In this prototype the answers are pre-written from the sources on this page.</p>
        </div>
      </div>
      <div class="panel room">
        <div class="chat" id="chat" aria-live="polite">
          <div class="msg bot">
            <span class="avatar" aria-hidden="true"></span>
            <div class="bubble">Ask me about {home.short} v {away.short}. Every answer shows where it came from.</div>
          </div>
        </div>
        <div class="chips" role="list">
          {u.questions.map((q, k) => (
            <button type="button" class="chip" data-q={k} role="listitem">
              {q.q}
            </button>
          ))}
        </div>
        {
          u.questions.map((q, k) => (
            <template data-answer={k}>
              <div class="msg me">
                <div class="bubble">{q.q}</div>
              </div>
              <div class="msg bot">
                <span class="avatar" aria-hidden="true" />
                <div class="bubble">
                  <Cited items={q.a} sources={sources} />
                </div>
              </div>
            </template>
          ))
        }
        <noscript>
          <dl class="faq">
            {u.questions.map((q) => (
              <>
                <dt>{q.q}</dt>
                <dd><Cited items={q.a} sources={sources} /></dd>
              </>
            ))}
          </dl>
        </noscript>
        <div class="composer" aria-hidden="true">
          <span>Ask anything about this match…</span>
          <span class="soon mono">coming soon</span>
        </div>
      </div>
    </section>

    <!-- Match Brief -->
    <section id="brief" class="block-section">
      <div class="section-head">
        <div>
          <span class="eyebrow">Match Brief · as it stood before kick-off</span>
          <h2>Going in</h2>
          <p>Built only from what was on file before {formatDate(m.date)}: form, recent meetings and who had the whistle.</p>
        </div>
      </div>
      <div class="brief">
        {
          form.map((f) => (
            <div class="panel brief-card">
              <div class="brief-club">
                <ClubBadge id={f.club.id} size={32} />
                <b>{f.club.name}</b>
              </div>
              <div class="form-row">
                {f.rows.map((r) => (
                  <span class:list={['res', r.r]} title={`${matchLine(r.x)} (${formatDate(r.x.date)})`}>
                    {r.r}
                  </span>
                ))}
              </div>
              <ul class="brief-list">
                {f.rows.map((r) => (
                  <li>
                    <span class="dim mono">MW{r.x.matchweek}</span> {r.venue === 'H' ? 'v' : '@'} {club(r.opp).name}{' '}
                    <b class="mono">
                      {r.f}–{r.a}
                    </b>
                  </li>
                ))}
              </ul>
              <p class="brief-sum mono">
                {f.pts} pts · {f.gf} scored · {f.ga} conceded
              </p>
            </div>
          ))
        }
        <div class="panel brief-card">
          <span class="eyebrow">Last meetings</span>
          <ul class="brief-list">
            {
              lastMeetings.map((x) => (
                <li>
                  <span class="dim mono">{formatDate(x.date, { month: 'short', year: 'numeric' })}</span> {matchLine(x)}
                  <span class="dim"> · ref {official(x.officials.referee).name}</span>
                </li>
              ))
            }
          </ul>
          <span class="eyebrow">On the whistle</span>
          <ul class="brief-list">
            {
              crew.map((c) => (
                <li>
                  <span class="dim">{roleName[c.role]}</span> {c.o.name}
                  <span class="dim"> · {pct(c.before?.accuracy ?? null)} accurate</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- Sources -->
    <section id="sources" class="block-section">
      <div class="section-head">
        <div>
          <span class="eyebrow">Receipts</span>
          <h2>Sources</h2>
          <p>Every numbered mark on this page points here. Spot something wrong? <a href={`https://github.com/yar-malik/referee-leaderboard/issues/new?template=correction.yml`}>Send a correction</a>.</p>
        </div>
      </div>
      <ol class="source-list">
        {
          u.sources.map((s, n) => (
            <li id={`source-${s.id}`}>
              <a href={s.url} target="_blank" rel="noopener" class="panel">
                <span class="src-n mono">{n + 1}</span>
                <span class="src-main">
                  <b>{s.title}</b>
                  <span class="dim">
                    {s.publisher}
                    {s.published && ` · ${tz(s.published)}`}
                  </span>
                </span>
                <span class:list={['tag', s.kind]}>{s.kind}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </section>
  </article>
</Base>

<script>
  // Share: native sheet where available, otherwise copy the link.
  for (const box of document.querySelectorAll<HTMLElement>('.share')) {
    const btn = box.querySelector<HTMLButtonElement>('[data-share]')!;
    const label = btn.querySelector<HTMLElement>('[data-label]')!;
    const url = location.href.split('#')[0] || box.dataset.url!;
    btn.addEventListener('click', async () => {
      try {
        if (navigator.share) return await navigator.share({ title: document.title, text: box.dataset.text, url });
        await navigator.clipboard.writeText(url);
        label.textContent = 'Link copied';
      } catch {
        label.textContent = 'Copy failed';
      }
      setTimeout(() => (label.textContent = 'Share'), 2000);
    });
  }

  // Match Room preview: reveal the pre-written, cited answer for a tapped question.
  const chat = document.getElementById('chat');
  for (const chip of document.querySelectorAll<HTMLButtonElement>('.chip')) {
    chip.addEventListener('click', () => {
      const tpl = document.querySelector<HTMLTemplateElement>(`template[data-answer="${chip.dataset.q}"]`);
      if (!chat || !tpl) return;
      chat.append(tpl.content.cloneNode(true));
      chip.disabled = true;
      chat.lastElementChild?.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    });
  }
</script>

