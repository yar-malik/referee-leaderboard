---
import Base from '../../layouts/Base.astro';
import ClubBadge from '../../components/ClubBadge.astro';
import Dot from '../../components/Dot.astro';
import FanHeat from '../../components/FanHeat.astro';
import {
  club,
  formatDate,
  href,
  incidentsFor,
  official,
  panelAccuracy,
  pct,
  seasonFiles,
  sentimentFor,
  aggrievedClubs,
  fanHeatByOfficial,
  verdictOf,
} from '../../lib/data';

export const getStaticPaths = () => seasonFiles.map((f) => ({ params: { season: f.season }, props: { file: f } }));

const { file } = Astro.props as { file: (typeof seasonFiles)[number] };
const weeks = [...new Set(file.matches.map((m) => m.matchweek))].sort((a, b) => b - a);
const acc = panelAccuracy(file.season);
const all = file.matches.flatMap((m) => incidentsFor(m));
const pending = all.filter((i) => verdictOf(i) === 'pending').length;
const errors = all.filter((i) => verdictOf(i) === 'error').length;
const overturns = all.filter((i) => i.varOutcome === 'overturned').length;
const ruledWeeks = [...new Set(all.filter((i) => i.verdictSource === 'kmi-panel').map((i) => i.matchweek))].sort();
const label = file.season.replace('-', '–');
const withFans = file.matches.map((m) => ({ m, s: sentimentFor(m) })).filter((x): x is { m: typeof x.m; s: NonNullable<typeof x.s> } => Boolean(x.s));
const hasFans = withFans.length > 0;
const angriest = [...withFans].sort((a, b) => b.s.outrage - a.s.outrage).slice(0, 8);
const fanOfficials = fanHeatByOfficial(file.season).slice(0, 8);
const aggrieved = aggrievedClubs(file.season).slice(0, 8);
const meanOutrage = hasFans ? withFans.reduce((n, x) => n + x.s.outrage, 0) / withFans.length : 0;
const allSeasons = seasonFiles.map((f) => f.season).sort().reverse();
const weekly = file.coverage === 'kmi-weekly';
const varStageErrors = all.filter((i) => i.calls.var === 'error' || (i.varOutcome === 'on-field-review-rejected' && i.calls.referee === 'error')).length;
const onFieldOnly = all.filter((i) => i.calls.referee === 'error' && i.calls.var !== 'error' && i.varOutcome !== 'on-field-review-rejected' && i.varOutcome !== 'overturned').length;
const interventions = all.filter((i) => i.varOutcome === 'overturned' || i.varOutcome === 'on-field-review-rejected').length;
---

<Base title={`Premier League ${label}`} description={`Every ${label} Premier League match with its referee, VAR and every key decision, rated by the KMI panel.`}>
  <section class="wrap section">
    <div class="head">
      <div>
        <span class="eyebrow">Premier League · Season</span>
        <div class="title-row">
          <h1 class="display">{label}</h1>
          <nav class="seasons" aria-label="Season">
            {allSeasons.map((s) => (
              <a href={href(`/season/${s}/`)} aria-current={s === file.season ? 'page' : undefined}>
                {s.replace('-', '–')}
              </a>
            ))}
          </nav>
        </div>
        {
          weekly ? (
            <p class="muted lede">
              Every match played so far, with its referee and VAR, and every key decision on record. Verdicts come from the
              Premier League's Key Match Incidents panel, which now publishes a ruling on every contentious call each week.
              {ruledWeeks.length > 0 && ` Panel rulings are in for matchweek${ruledWeeks.length > 1 ? 's' : ''} ${ruledWeeks.join('–')}.`}
              {pending > 0 && ' Later incidents show as awaiting panel until the next ruling is published.'}
            </p>
          ) : (
            <p class="muted lede">
              All 380 matches with their officials. The key decisions are every VAR intervention from the Premier League's
              match data, plus every error on the KMI panel's end-of-season list (published by BBC Sport). Weekly rulings
              weren't public that season, so interventions that aren't on the error list are marked correct, because the
              panel voted everything it didn't list as correct.
            </p>
          )
        }
      </div>
    </div>

    {
      weekly ? (
        <dl class="kpis">
          <div><dt>Matches played</dt><dd>{file.matches.length}</dd></div>
          <div><dt>Key decisions logged</dt><dd>{all.length}</dd></div>
          <div><dt>VAR overturns</dt><dd>{overturns}</dd></div>
          <div><dt>Wrong final decisions</dt><dd class="neg">{errors}</dd></div>
          <div><dt>Right on the pitch</dt><dd>{pct(acc.onField)}</dd></div>
          <div><dt>Final decision right</dt><dd class="pos">{pct(acc.final)}</dd></div>
        </dl>
      ) : (
        <dl class="kpis">
          <div><dt>Matches</dt><dd>{file.matches.length}</dd></div>
          <div><dt>Decisions logged</dt><dd>{all.length}</dd></div>
          <div><dt>VAR interventions</dt><dd>{interventions}</dd></div>
          <div><dt>VAR errors</dt><dd class="neg">{varStageErrors}</dd></div>
          <div><dt>On-field errors VAR couldn't fix</dt><dd class="neg">{onFieldOnly}</dd></div>
          <div><dt>Wrong final decisions</dt><dd class="neg">{errors}</dd></div>
        </dl>
      )
    }

    {
      hasFans && (
        <section class="fans" id="fans">
          <div class="section-head">
            <div>
              <span class="eyebrow">r/soccer post-match threads</span>
              <h2 class="display">What the fans thought</h2>
              <p>
                We read the r/soccer post-match thread for {withFans.length} of {file.matches.length} matches and measured how much
                of each one was anger at the officiating, weighted by upvotes. Average outrage this season: {Math.round(meanOutrage)}/100.
                It's a mood reading, not a verdict. The panel's rulings are in the match tables below.
              </p>
            </div>
          </div>
          <div class="fan-grid">
            <div class="panel fan-card">
              <h3>Angriest threads</h3>
              <ol>
                {angriest.map(({ m, s }) => (
                  <li>
                    <a class="fan-row" href={s.thread.url} rel="noopener" target="_blank">
                      <span class="fan-match">
                        <b>
                          {club(m.home).short} {m.score.replace('-', '–')} {club(m.away).short}
                        </b>
                        <span class="dim">
                          MW{m.matchweek} · {s.topics.join(', ') || 'officiating'}
                          {s.lean && ` · ${club(s.lean).short} fans felt wronged`}
                        </span>
                      </span>
                      <FanHeat outrage={s.outrage} />
                    </a>
                    {s.quotes[0] && <blockquote>“{s.quotes[0].text}”<cite> · {s.quotes[0].score.toLocaleString()} upvotes</cite></blockquote>}
                  </li>
                ))}
              </ol>
            </div>
            <div class="fan-side">
              <div class="panel fan-card">
                <h3>Officials fans complained about most</h3>
                <p class="dim fine">Average thread outrage across the matches they refereed or VAR'd (5+ matches).</p>
                <ol class="plain">
                  {fanOfficials.map((o) => (
                    <li>
                      <a class="fan-row" href={href(`/officials/${o.official.id}/`)}>
                        <span class="fan-match">
                          <b>{o.official.name}</b>
                          <span class="dim">{o.n} threads · worst: {club(o.worst.m.home).short} v {club(o.worst.m.away).short} ({o.worst.s.outrage})</span>
                        </span>
                        <FanHeat outrage={Math.round(o.avg)} size="sm" />
                      </a>
                    </li>
                  ))}
                </ol>
              </div>
              <div class="panel fan-card">
                <h3>Most aggrieved fanbases</h3>
                <p class="dim fine">How many threads their fans were the angrier side. Bigger clubs have more flaired fans posting, so this leans towards them.</p>
                <ol class="plain">
                  {aggrieved.map((c) => (
                    <li>
                      <a class="fan-row" href={href(`/clubs/${c.club.id}/`)}>
                        <span class="fan-match club">
                          <ClubBadge id={c.club.id} size={22} />
                          <b>{c.club.name}</b>
                        </span>
                        <span class="mono dim">
                          <b class="neg">{c.wronged}</b> / {c.threads}
                        </span>
                      </a>
                    </li>
                  ))}
                </ol>
              </div>
            </div>
          </div>
        </section>
      )
    }

    <p class="legend muted">
      <span><Dot verdict="correct" size={16} /> Correct</span>
      <span><Dot verdict="error" size={16} /> Error</span>
      <span><Dot verdict="debatable" size={16} /> Debatable</span>
      {pending > 0 && (
        <span>
          <Dot verdict="pending" size={16} /> Awaiting panel
        </span>
      )}
    </p>

    {
      weeks.map((w) => {
        const list = file.matches.filter((m) => m.matchweek === w);
        return (
          <section class="week" id={`matchweek-${w}`}>
            <div class="week-head">
              <h2>Matchweek {w}</h2>
              <span class="muted">
                {formatDate(list[0].date, { day: 'numeric', month: 'short' })} –{' '}
                {formatDate(list[list.length - 1].date, { day: 'numeric', month: 'short' })}
              </span>
            </div>
            <div class="panel table-scroll">
              <table class="data matches">
                <colgroup>
                  <col style="width:11%" />
                  <col style="width:20%" />
                  <col style="width:8%" />
                  <col style="width:20%" />
                  <col style="width:14%" />
                  <col style="width:14%" />
                  <col style="width:13%" />
                  {hasFans && <col style="width:11%" />}
                </colgroup>
                <thead>
                  <tr>
                    <th>Date</th>
                    <th class="r">Home</th>
                    <th class="c" />
                    <th>Away</th>
                    <th>Referee</th>
                    <th>VAR</th>
                    <th>Key decisions</th>
                    {hasFans && <th>Fan heat</th>}
                  </tr>
                </thead>
                <tbody>
                  {list.map((m) => {
                    const inc = incidentsFor(m).sort((a, b) => parseInt(a.minute) - parseInt(b.minute));
                    return (
                      <tr>
                        <td class="dim date">{formatDate(m.date, { weekday: 'short', day: 'numeric', month: 'short' })}</td>
                        <td class="r">
                          <a class="team" href={href(`/clubs/${m.home}/`)}>
                            <span class="tn">{club(m.home).name}</span>
                            <ClubBadge id={m.home} size={24} />
                          </a>
                        </td>
                        <td class="c score">{m.score.replace('-', ' – ')}</td>
                        <td>
                          <a class="team" href={href(`/clubs/${m.away}/`)}>
                            <ClubBadge id={m.away} size={24} />
                            <span class="tn">{club(m.away).name}</span>
                          </a>
                        </td>
                        <td>
                          <a class="off" href={href(`/officials/${m.officials.referee}/`)}>
                            {official(m.officials.referee).name}
                          </a>
                        </td>
                        <td>
                          {m.officials.var && (
                            <a class="off" href={href(`/officials/${m.officials.var}/`)}>
                              {official(m.officials.var).name}
                            </a>
                          )}
                        </td>
                        <td>
                          <span class="dots">
                            {inc.length === 0 && <span class="dim none">None flagged</span>}
                            {inc.map((i) => (
                              <a href={href(`/incidents/${i.id}/`)} title={`${i.minute} ${i.title}`}>
                                <Dot verdict={verdictOf(i)} size={20} />
                              </a>
                            ))}
                          </span>
                        </td>
                        {hasFans && (
                          <td>
                            {(() => {
                              const f = sentimentFor(m);
                              return f ? (
                                <a class="fh" href={f.thread.url} rel="noopener" target="_blank" title={`${f.thread.title} · ${f.angry} angry comments of ${f.comments}`}>
                                  <FanHeat outrage={f.outrage} size="sm" />
                                </a>
                              ) : (
                                <span class="dim none">—</span>
                              );
                            })()}
                          </td>
                        )}
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          </section>
        );
      })
    }

    <p class="dim src">
      Results and match officials: <a href={file.source.url}>{file.source.publisher}</a>. Verdicts: Premier League KMI
      panel weekly outcomes.
    </p>
  </section>
</Base>

<style>
  h1 {
    font-size: clamp(36px, 6vw, 56px);
    margin: 4px 0 0;
  }
  .title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px 24px;
  }
  .seasons {
    display: flex;
    gap: 2px;
    padding: 4px;
    border-radius: 999px;
    background: var(--pill);
  }
  .seasons a {
    padding: 7px 16px;
    border-radius: 999px;
    font-size: 14.5px;
    font-weight: 500;
    color: var(--muted);
  }
  .seasons a[aria-current='page'] {
    background: var(--panel);
    color: var(--text);
    box-shadow: 0 1px 3px rgba(17, 17, 19, 0.1);
  }
  .lede {
    max-width: 72ch;
    margin: 10px 0 0;
  }
  .kpis {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 10px;
    margin: 28px 0 18px;
  }
  .kpis div {
    background: var(--bg-2);
    border-radius: var(--radius);
    padding: 14px 16px;
  }
  .kpis dt {
    font-size: 13px;
    color: var(--muted);
  }
  .kpis dd {
    margin: 4px 0 0;
    font-size: 28px;
    font-weight: 600;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }
  @media (max-width: 900px) {
    .kpis {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 520px) {
    .kpis {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    font-size: 14px;
    margin: 0 0 8px;
  }
  .legend span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .week {
    margin-top: 32px;
  }
  .week-head {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 12px;
  }
  .week-head h2 {
    margin: 0;
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .matches {
    min-width: 980px;
    table-layout: fixed;
  }
  .matches td {
    padding-block: 10px;
  }
  .date {
    white-space: nowrap;
    font-size: 14px;
  }
  .r {
    text-align: right;
  }
  .c {
    text-align: center;
  }
  .team {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 500;
  }
  .team:hover .tn,
  .off:hover {
    color: var(--brand);
  }
  .score {
    font-size: 16px;
    font-weight: 600;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .off {
    font-size: 14px;
    white-space: nowrap;
  }
  .dots {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 5px;
    align-items: center;
  }
  .dots a:hover {
    transform: scale(1.12);
  }
  .none {
    font-size: 13px;
  }
  .src {
    font-size: 13px;
    margin-top: 24px;
  }
  .fh:hover :global(.n) {
    color: var(--brand);
  }
  .fans {
    margin: 40px 0 48px;
  }
  .fan-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 16px;
    align-items: start;
  }
  .fan-side {
    display: grid;
    gap: 16px;
  }
  @media (max-width: 900px) {
    .fan-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .fan-card {
    padding: 18px 20px;
  }
  .fan-card h3 {
    margin: 0 0 6px;
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .fine {
    font-size: 13px;
    margin: 0 0 8px;
  }
  .fan-card ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .fan-card li {
    padding: 10px 0;
    border-top: 1px solid var(--line);
  }
  .fan-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .fan-row:hover b {
    color: var(--brand);
  }
  .fan-match {
    display: flex;
    flex-direction: column;
    min-width: 0;
    font-size: 14.5px;
  }
  .fan-match.club {
    flex-direction: row;
    align-items: center;
    gap: 8px;
  }
  .fan-match .dim {
    font-size: 12.5px;
  }
  .fan-card blockquote {
    margin: 8px 0 0;
    padding: 10px 14px;
    border-radius: 10px;
    background: var(--bg-2);
    font-size: 13.5px;
    line-height: 1.45;
    color: var(--muted);
  }
  .fan-card cite {
    font-style: normal;
    color: var(--dim);
    font-size: 12px;
  }
</style>
