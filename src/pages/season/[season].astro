---
import Base from '../../layouts/Base.astro';
import ClubBadge from '../../components/ClubBadge.astro';
import Dot from '../../components/Dot.astro';
import {
  club,
  formatDate,
  href,
  incidentsFor,
  official,
  panelAccuracy,
  pct,
  seasonFiles,
  verdictOf,
} from '../../lib/data';

export const getStaticPaths = () => seasonFiles.map((f) => ({ params: { season: f.season }, props: { file: f } }));

const { file } = Astro.props as { file: (typeof seasonFiles)[number] };
const weeks = [...new Set(file.matches.map((m) => m.matchweek))].sort((a, b) => b - a);
const acc = panelAccuracy(file.season);
const all = file.matches.flatMap((m) => incidentsFor(m));
const pending = all.filter((i) => verdictOf(i) === 'pending').length;
const errors = all.filter((i) => verdictOf(i) === 'error').length;
const overturns = all.filter((i) => i.varOutcome === 'overturned').length;
const ruledWeeks = [...new Set(all.filter((i) => i.verdictSource === 'kmi-panel').map((i) => i.matchweek))].sort();
const label = file.season.replace('-', '–');
---

<Base title={`Premier League ${label}`} description={`Every ${label} Premier League match with its referee, VAR and every key decision, rated by the KMI panel.`}>
  <section class="wrap section">
    <div class="head">
      <div>
        <span class="eyebrow">Premier League · Season</span>
        <h1 class="display">{label}</h1>
        <p class="muted lede">
          Every match played so far, with its referee and VAR, and every key decision on record. Verdicts come from the
          Premier League's Key Match Incidents panel, which now publishes a ruling on every contentious call each week.
          {ruledWeeks.length > 0 && ` Panel rulings are in for matchweek${ruledWeeks.length > 1 ? 's' : ''} ${ruledWeeks.join('–')}.`}
          {pending > 0 && ' Later incidents show as awaiting panel until the next ruling is published.'}
        </p>
      </div>
    </div>

    <dl class="kpis">
      <div><dt>Matches played</dt><dd>{file.matches.length}</dd></div>
      <div><dt>Key decisions logged</dt><dd>{all.length}</dd></div>
      <div><dt>VAR overturns</dt><dd>{overturns}</dd></div>
      <div><dt>Wrong final decisions</dt><dd class="neg">{errors}</dd></div>
      <div><dt>Right on the pitch</dt><dd>{pct(acc.onField)}</dd></div>
      <div><dt>Final decision right</dt><dd class="pos">{pct(acc.final)}</dd></div>
    </dl>

    <p class="legend muted">
      <span><Dot verdict="correct" size={16} /> Correct</span>
      <span><Dot verdict="error" size={16} /> Error</span>
      <span><Dot verdict="debatable" size={16} /> Debatable</span>
      <span><Dot verdict="pending" size={16} /> Awaiting panel</span>
    </p>

    {
      weeks.map((w) => {
        const list = file.matches.filter((m) => m.matchweek === w);
        return (
          <section class="week" id={`matchweek-${w}`}>
            <div class="week-head">
              <h2>Matchweek {w}</h2>
              <span class="muted">
                {formatDate(list[0].date, { day: 'numeric', month: 'short' })} –{' '}
                {formatDate(list[list.length - 1].date, { day: 'numeric', month: 'short' })}
              </span>
            </div>
            <div class="panel table-scroll">
              <table class="data matches">
                <colgroup>
                  <col style="width:11%" />
                  <col style="width:20%" />
                  <col style="width:8%" />
                  <col style="width:20%" />
                  <col style="width:14%" />
                  <col style="width:14%" />
                  <col style="width:13%" />
                </colgroup>
                <thead>
                  <tr>
                    <th>Date</th>
                    <th class="r">Home</th>
                    <th class="c" />
                    <th>Away</th>
                    <th>Referee</th>
                    <th>VAR</th>
                    <th>Key decisions</th>
                  </tr>
                </thead>
                <tbody>
                  {list.map((m) => {
                    const inc = incidentsFor(m).sort((a, b) => parseInt(a.minute) - parseInt(b.minute));
                    return (
                      <tr>
                        <td class="dim date">{formatDate(m.date, { weekday: 'short', day: 'numeric', month: 'short' })}</td>
                        <td class="r">
                          <a class="team" href={href(`/clubs/${m.home}/`)}>
                            <span class="tn">{club(m.home).name}</span>
                            <ClubBadge id={m.home} size={24} />
                          </a>
                        </td>
                        <td class="c score">{m.score.replace('-', ' – ')}</td>
                        <td>
                          <a class="team" href={href(`/clubs/${m.away}/`)}>
                            <ClubBadge id={m.away} size={24} />
                            <span class="tn">{club(m.away).name}</span>
                          </a>
                        </td>
                        <td>
                          <a class="off" href={href(`/officials/${m.officials.referee}/`)}>
                            {official(m.officials.referee).name}
                          </a>
                        </td>
                        <td>
                          {m.officials.var && (
                            <a class="off" href={href(`/officials/${m.officials.var}/`)}>
                              {official(m.officials.var).name}
                            </a>
                          )}
                        </td>
                        <td>
                          <span class="dots">
                            {inc.length === 0 && <span class="dim none">None flagged</span>}
                            {inc.map((i) => (
                              <a href={href(`/incidents/${i.id}/`)} title={`${i.minute} ${i.title}`}>
                                <Dot verdict={verdictOf(i)} size={20} />
                              </a>
                            ))}
                          </span>
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          </section>
        );
      })
    }

    <p class="dim src">
      Results and match officials: <a href={file.source.url}>{file.source.publisher}</a>. Verdicts: Premier League KMI
      panel weekly outcomes.
    </p>
  </section>
</Base>

<style>
  h1 {
    font-size: clamp(36px, 6vw, 56px);
    margin: 4px 0 0;
  }
  .lede {
    max-width: 72ch;
    margin: 10px 0 0;
  }
  .kpis {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 10px;
    margin: 28px 0 18px;
  }
  .kpis div {
    background: var(--bg-2);
    border-radius: var(--radius);
    padding: 14px 16px;
  }
  .kpis dt {
    font-size: 13px;
    color: var(--muted);
  }
  .kpis dd {
    margin: 4px 0 0;
    font-size: 28px;
    font-weight: 600;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }
  @media (max-width: 900px) {
    .kpis {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 520px) {
    .kpis {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    font-size: 14px;
    margin: 0 0 8px;
  }
  .legend span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .week {
    margin-top: 32px;
  }
  .week-head {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 12px;
  }
  .week-head h2 {
    margin: 0;
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .matches {
    min-width: 980px;
    table-layout: fixed;
  }
  .matches td {
    padding-block: 10px;
  }
  .date {
    white-space: nowrap;
    font-size: 14px;
  }
  .r {
    text-align: right;
  }
  .c {
    text-align: center;
  }
  .team {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 500;
  }
  .team:hover .tn,
  .off:hover {
    color: var(--brand);
  }
  .score {
    font-size: 16px;
    font-weight: 600;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .off {
    font-size: 14px;
    white-space: nowrap;
  }
  .dots {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 5px;
    align-items: center;
  }
  .dots a:hover {
    transform: scale(1.12);
  }
  .none {
    font-size: 13px;
  }
  .src {
    font-size: 13px;
    margin-top: 24px;
  }
</style>
