---
import Base from '../layouts/Base.astro';
import ClubBadge from '../components/ClubBadge.astro';
import Heat from '../components/Heat.astro';
import IncidentRow from '../components/IncidentRow.astro';
import LastFive from '../components/LastFive.astro';
import Verdict from '../components/Verdict.astro';
import {
  OUTCOME_LABEL,
  SOURCE_LABEL,
  benefitMatrix,
  bestOfficials,
  club,
  clubStats,
  formatDate,
  href,
  incidents,
  isConfirmed,
  official,
  officialStats,
  panelAccuracy,
  pct,
  seasonFiles,
  seasonTallies,
  verdictOf,
  worstOfficials,
} from '../lib/data';

const featured = incidents.find((i) => i.featured) ?? incidents[0];
const stats = officialStats();
const worst = worstOfficials(stats).slice(0, 6);
const best = bestOfficials(stats).slice(0, 6);
const ledger = clubStats().filter((c) => c.errorsFor + c.errorsAgainst > 0);
const maxAbs = Math.max(1, ...ledger.map((c) => Math.max(c.errorsFor, c.errorsAgainst)));
const matrix = benefitMatrix();

const errorCount = incidents.filter((i) => verdictOf(i) === 'error').length;
const confirmedErrors = incidents.filter((i) => verdictOf(i) === 'error' && isConfirmed(i)).length;
const decidingErrors = incidents.filter((i) => verdictOf(i) === 'error' && i.impact === 'match-deciding').length;

const featuredPeople = (['referee', 'var', 'avar'] as const)
  .map((role) => ({ role, id: featured.officials[role] }))
  .filter((p): p is { role: 'referee' | 'var' | 'avar'; id: string } => Boolean(p.id))
  .map((p) => ({ ...p, stats: stats.find((s) => s.official.id === p.id)! }));
const discussion = featured.sources.filter((s) => s.kind === 'discussion');
const reporting = featured.sources.filter((s) => s.kind !== 'discussion');

const kmi = seasonTallies.find((t) => t.season === '2025-26');
const kmiRows = kmi
  ? kmi.var
      .map((v) => {
        const r = kmi.referee.find((x) => x.club === v.club) ?? { for: 0, against: 0 };
        return { club: v.club, varNet: v.for - v.against, refNet: r.for - r.against, net: v.for - v.against + r.for - r.against, for: v.for + r.for, against: v.against + r.against };
      })
      .sort((a, b) => b.net - a.net || b.for - a.for)
  : [];
const kmiMax = Math.max(1, ...kmiRows.map((r) => Math.abs(r.net)));
const roleLabel = { referee: 'Referee', var: 'VAR', avar: 'Assistant VAR' };
const current = seasonFiles.map((f) => f.season).sort().reverse()[0];
const currentFile = seasonFiles.find((f) => f.season === current)!;
const seasonAcc = panelAccuracy(current);
const seasonIncidents = incidents.filter((i) => i.season === current);
const lastWeek = Math.max(...currentFile.matches.map((m) => m.matchweek));
---

<Base>
  <!-- ─── Hero ─── -->
  <section class="wrap hero">
    <div class="league">
      <span class="league-mark" aria-hidden="true">
        <svg viewBox="0 0 32 32" width="44" height="44">
          <rect x="1" y="5" width="30" height="20" rx="4" fill="currentColor"></rect>
          <path d="M9 29h14" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"></path>
          <path d="M11.5 9.5 L11.5 20.5" stroke="#ea4335" stroke-width="2.6" stroke-linecap="round"></path>
          <path d="M20.5 9.5 L20.5 20.5" stroke="#34a853" stroke-width="2.6" stroke-linecap="round"></path>
        </svg>
      </span>
      <div>
        <h1 class="display">Every VAR call, on the record</h1>
        <p class="sub">Premier League · {incidents[0].season.replace('-', '–')} · updated {formatDate(incidents[0].date)}</p>
      </div>
    </div>
    <p class="lede">
      An open, community-edited ledger of the refereeing decisions that decide seasons. See which officials got it wrong,
      which clubs benefited, and how the record looks over time. Every claim is sourced.
    </p>
    <div class="cta">
      <a class="btn btn-primary" href="#leaderboard">View the leaderboard</a>
      <a class="btn" href={href('/incidents/')}>Browse incidents</a>
    </div>
    <a class="season-band" href={href(`/season/${current}/`)}>
      <span class="sb-title">
        <b>{current.replace('-', '–')} season, tracked in full</b>
        <span class="muted">
          All {currentFile.matches.length} matches through matchweek {lastWeek} · {seasonIncidents.length} key decisions · KMI panel:{' '}
          {pct(seasonAcc.onField)} of calls right on the pitch, {pct(seasonAcc.final)} right once VAR had its say
        </span>
      </span>
      <span class="link-arrow">Open season →</span>
    </a>
    <dl class="kpis">
      <div><dt>Incidents logged</dt><dd>{incidents.length}</dd></div>
      <div><dt>Errors</dt><dd class="neg">{errorCount}</dd></div>
      <div><dt>Officially admitted</dt><dd>{confirmedErrors}</dd></div>
      <div><dt>Match-deciding errors</dt><dd>{decidingErrors}</dd></div>
    </dl>
  </section>

  <!-- ─── Featured case ─── -->
  <section class="wrap feature-wrap">
    <article class="case panel">
      <header class="case-head">
        <div class="case-label">
          <span class="eyebrow">Case file · this week</span>
          <Verdict verdict={verdictOf(featured)} size="lg" />
          <span class="tag">{SOURCE_LABEL[featured.verdictSource]}</span>
        </div>
        <Heat level={featured.controversy} showLabel />
      </header>

      <div class="scoreboard">
        <div class="team">
          <ClubBadge id={featured.home} size={64} link />
          <span class="team-name">{club(featured.home).name}</span>
        </div>
        <div class="score-mid">
          <div class="score">{featured.score.replace('-', ' – ')}</div>
          <div class="eyebrow">{formatDate(featured.date, { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' })}</div>
        </div>
        <div class="team">
          <ClubBadge id={featured.away} size={64} link />
          <span class="team-name">{club(featured.away).name}</span>
        </div>
      </div>

      <div class="case-grid">
        <div class="case-main">
          <h2 class="case-title">{featured.title}</h2>
          <p class="summary">{featured.summary}</p>

          <ol class="timeline">
            <li><span class="t">{featured.minute}</span><span>On the pitch: <b>{featured.onField}</b></span></li>
            <li><span class="t">VAR</span><span><b class:list={{ neg: verdictOf(featured) === 'error' }}>{OUTCOME_LABEL[featured.varOutcome]}</b></span></li>
            {featured.consequences.slice(0, 2).map((c) => <li><span class="t">After</span><span>{c}</span></li>)}
          </ol>

          <div class="officials">
            {
              featuredPeople.map((p) => (
                <a class="off" href={href(`/officials/${p.id}/`)}>
                  <span class="eyebrow">{roleLabel[p.role]}</span>
                  <span class="off-name">{official(p.id).name}</span>
                  <span class="off-call">
                    <Verdict verdict={p.role === 'referee' ? featured.calls.referee : featured.calls.var} size="sm" />
                    <span class="dim">
                      {p.stats.errors} err · {pct(p.stats.accuracy)} acc
                    </span>
                  </span>
                </a>
              ))
            }
          </div>

          <div class="pulse">
            <h3 class="eyebrow">Where fans are arguing</h3>
            {
              discussion.map((d) => (
                <a class="thread" href={d.url} rel="noopener" target="_blank">
                  <span class="thread-src">{d.publisher}</span>
                  <span>{d.title}</span>
                </a>
              ))
            }
          </div>
        </div>

        <aside class="reactions">
          <h3 class="eyebrow">The reaction</h3>
          <ul>
            {
              featured.reactions.map((r) => (
                <li>
                  <blockquote class:list={{ para: r.paraphrased }}>{r.paraphrased ? r.quote : `“${r.quote}”`}</blockquote>
                  <cite>
                    <b>{r.who}</b>
                    {r.role && <span class="dim"> · {r.role}</span>}
                  </cite>
                </li>
              ))
            }
          </ul>
        </aside>
      </div>
      <footer class="case-foot">
        <span class="dim">Sources:</span>
        {reporting.map((s) => <a href={s.url} rel="noopener" target="_blank">{s.publisher}</a>)}
        <a class="link-arrow" href={href(`/incidents/${featured.id}/`)}>Full case file →</a>
      </footer>
    </article>
  </section>

  <!-- ─── Officials leaderboard ─── -->
  <section class="wrap section" id="leaderboard">
    <div class="section-head">
      <div>
        <span class="eyebrow">The leaderboard</span>
        <h2 class="display">Officials</h2>
        <p>
          Each official is rated only on the calls they were responsible for. Errors are weighted by impact: a
          match-deciding error costs 3, a minor one costs 1. The AVAR shares the VAR's verdict.
        </p>
      </div>
      <a class="link-arrow" href={href('/officials/')}>All officials →</a>
    </div>

    <div class="boards">
      <div class="board panel">
        <div class="board-head">
          <h3>Hall of shame</h3>
          <span class="eyebrow">by damage score</span>
        </div>
        <ol>
          {
            worst.map((s, n) => (
              <li>
                <a href={href(`/officials/${s.official.id}/`)} class="lb-row">
                  <span class="rank">{String(n + 1).padStart(2, '0')}</span>
                  <span class="lb-name">
                    <b>{s.official.name}</b>
                    <span class="dim">
                      {s.errors} error{s.errors === 1 ? '' : 's'}
                      {s.matchDeciding > 0 && <span class="neg"> · {s.matchDeciding} match-deciding</span>}
                    </span>
                  </span>
                  <span class="lb-benef">
                    {[...s.benefitedBy.entries()].sort((a, b) => b[1] - a[1]).slice(0, 3).map(([c]) => <ClubBadge id={c} size={22} />)}
                  </span>
                  <span class="lb-score neg">{s.damage % 1 ? s.damage.toFixed(1) : s.damage}</span>
                </a>
              </li>
            ))
          }
        </ol>
        <p class="board-note dim">Badges show the clubs that benefited from that official's errors.</p>
      </div>

      <div class="board panel">
        <div class="board-head">
          <h3>Clean sheet</h3>
          <span class="eyebrow">by accuracy</span>
        </div>
        <ol>
          {
            best.map((s, n) => (
              <li>
                <a href={href(`/officials/${s.official.id}/`)} class="lb-row">
                  <span class="rank">{String(n + 1).padStart(2, '0')}</span>
                  <span class="lb-name">
                    <b>{s.official.name}</b>
                    <span class="dim">
                      {s.correct} correct · {s.errors} wrong
                    </span>
                  </span>
                  <LastFive decisions={s.decisions} size={18} link={false} />
                  <span class="lb-score pos">{pct(s.accuracy)}</span>
                </a>
              </li>
            ))
          }
        </ol>
        <p class="board-note dim">Early days: small samples swing hard. More logged calls make this fairer.</p>
      </div>
    </div>
  </section>

  <!-- ─── Club ledger ─── -->
  <section class="wrap section tight">
    <div class="section-head">
      <div>
        <span class="eyebrow">Who benefits</span>
        <h2 class="display">Club ledger</h2>
        <p>Errors that went for and against each club across every incident on file. Green means the club gained.</p>
      </div>
      <a class="link-arrow" href={href('/clubs/')}>All clubs →</a>
    </div>
    <div class="ledger panel">
      <div class="ledger-legend dim"><span>◀ against</span><span>for ▶</span></div>
      {
        ledger.map((c) => (
          <a class="led-row" href={href(`/clubs/${c.club.id}/`)}>
            <span class="led-club">
              <ClubBadge id={c.club.id} size={26} />
              <span>{c.club.name}</span>
            </span>
            <span class="led-bars">
              <span class="half left">
                <span class="bar neg-bar" style={`width:${(c.errorsAgainst / maxAbs) * 100}%`}>
                  {c.errorsAgainst > 0 && <i>{c.errorsAgainst}</i>}
                </span>
              </span>
              <span class="half right">
                <span class="bar pos-bar" style={`width:${(c.errorsFor / maxAbs) * 100}%`}>
                  {c.errorsFor > 0 && <i>{c.errorsFor}</i>}
                </span>
              </span>
            </span>
            <span class:list={['led-net', c.net > 0 ? 'pos' : c.net < 0 ? 'neg' : 'dim']}>
              {c.net > 0 ? `+${c.net}` : c.net}
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- ─── Heatmap ─── -->
  <section class="wrap section tight">
    <div class="section-head">
      <div>
        <span class="eyebrow">Patterns</span>
        <h2 class="display">Who their mistakes helped</h2>
        <p>
          Net effect of each official's errors on each club. Green cells mean the club gained and red cells mean it lost.
          A pattern here is a reason to look closer, not proof of bias.
        </p>
      </div>
    </div>
    <div class="panel heat-wrap table-scroll">
      <table class="heatmap">
        <thead>
          <tr>
            <th></th>
            {matrix.clubIds.map((c) => <th><ClubBadge id={c} size={26} /></th>)}
          </tr>
        </thead>
        <tbody>
          {
            matrix.rows.map((r) => (
              <tr>
                <th scope="row">
                  <a href={href(`/officials/${r.stats.official.id}/`)}>{r.stats.official.name}</a>
                </th>
                {r.cells.map((v, n) => (
                  <td
                    class:list={['cell', v > 0 ? 'up' : v < 0 ? 'down' : '']}
                    style={`--a:${Math.min(1, Math.abs(v) / 2)}`}
                    title={`${r.stats.official.name} → ${club(matrix.clubIds[n]).name}: ${v > 0 ? '+' : ''}${v}`}
                  >
                    {v !== 0 ? (v > 0 ? `+${v}` : v) : ''}
                  </td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <!-- ─── Latest incidents ─── -->
  <section class="wrap section tight">
    <div class="section-head">
      <div>
        <span class="eyebrow">The feed</span>
        <h2 class="display">Latest incidents</h2>
      </div>
      <a class="link-arrow" href={href('/incidents/')}>All {incidents.length} incidents →</a>
    </div>
    <div class="panel feed">
      {incidents.slice(0, 8).map((i) => <IncidentRow incident={i} />)}
    </div>
  </section>

  <!-- ─── KMI official season table ─── -->
  {
    kmi && (
      <section class="wrap section tight">
        <div class="section-head">
          <div>
            <span class="eyebrow">Official record · 2025-26</span>
            <h2 class="display">What the panel ruled</h2>
            <p>
              The Premier League's Key Match Incidents panel reviews every contentious call. These are its final
              2025-26 tallies of VAR and referee errors for and against each club.
            </p>
          </div>
          <a class="link-arrow" href={href('/clubs/#kmi')}>Full table →</a>
        </div>
        <div class="panel kmi">
          {kmiRows.map((r) => (
            <a class="kmi-row" href={href(`/clubs/${r.club}/`)}>
              <span class="led-club">
                <ClubBadge id={r.club} size={24} />
                <span>{club(r.club).name}</span>
              </span>
              <span class="kmi-track">
                <span class="kmi-zero" />
                <span
                  class:list={['kmi-bar', r.net >= 0 ? 'up' : 'down']}
                  style={`--w:${(Math.abs(r.net) / kmiMax) * 50}%`}
                />
              </span>
              <span class="kmi-split dim">
                {r.for}↑ {r.against}↓
              </span>
              <span class:list={['led-net', r.net > 0 ? 'pos' : r.net < 0 ? 'neg' : 'dim']}>{r.net > 0 ? `+${r.net}` : r.net}</span>
            </a>
          ))}
          <p class="board-note dim">
            Source: <a href={kmi.sources[0].url}>{kmi.sources[0].publisher}</a>. Combined VAR and on-field errors.
          </p>
        </div>
      </section>
    )
  }

  <!-- ─── Contribute ─── -->
  <section class="wrap section">
    <div class="join panel">
      <div>
        <span class="eyebrow">Open source · open data</span>
        <h2 class="display">Saw a howler? Put it on the record.</h2>
        <p class="muted">
          Every incident is a small JSON file in a public GitHub repo. Submit one through a guided form or open a pull
          request. Every entry needs a source, and panel rulings update verdicts as they come in.
        </p>
      </div>
      <div class="join-cta">
        <a class="btn btn-primary" href={href('/contribute/')}>Log an incident</a>
        <a class="btn" href={href('/method/')}>How verdicts work</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    padding-block: clamp(36px, 6vw, 64px) 8px;
  }
  .league {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .league-mark {
    flex: none;
    display: grid;
    place-items: center;
    width: 76px;
    height: 76px;
    border-radius: 20px;
    background: var(--pill);
    color: var(--text);
  }
  h1 {
    font-size: clamp(32px, 5vw, 52px);
    margin: 0;
  }
  .sub {
    margin: 4px 0 0;
    font-size: clamp(15px, 1.6vw, 18px);
    color: var(--muted);
  }
  .lede {
    max-width: 66ch;
    font-size: 16.5px;
    color: var(--muted);
    margin: 24px 0 0;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 22px;
  }
  .kpis {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    margin: 32px 0 0;
  }
  .kpis div {
    background: var(--bg-2);
    border-radius: var(--radius);
    padding: 16px 20px;
  }
  .kpis dt {
    font-size: 14px;
    color: var(--muted);
  }
  .kpis dd {
    margin: 4px 0 0;
    font-size: clamp(30px, 4vw, 40px);
    font-weight: 600;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }
  @media (max-width: 720px) {
    .kpis {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .league-mark {
      width: 56px;
      height: 56px;
      border-radius: 14px;
    }
    .league-mark svg {
      width: 32px;
      height: 32px;
    }
  }

  .season-band {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px 20px;
    margin-top: 28px;
    padding: 16px 20px;
    border-radius: var(--radius);
    background: var(--brand-soft);
  }
  .sb-title {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 14.5px;
  }
  .sb-title b {
    font-size: 16px;
    font-weight: 600;
  }
  .season-band .link-arrow {
    background: var(--panel);
  }

  /* Featured case */
  .feature-wrap {
    padding-top: 32px;
  }
  .case {
    overflow: hidden;
  }
  .case-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    padding: 16px 24px;
    border-bottom: 1px solid var(--line);
  }
  .case-label {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
  }
  .scoreboard {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
    padding: 28px 24px 24px;
  }
  .team {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    text-align: center;
  }
  .team-name {
    font-weight: 500;
    font-size: clamp(14px, 1.8vw, 18px);
  }
  .score-mid {
    text-align: center;
  }
  .score {
    font-size: clamp(48px, 7vw, 76px);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.05;
    font-variant-numeric: tabular-nums;
  }
  .case-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    border-top: 1px solid var(--line);
  }
  .case-main {
    padding: 24px;
  }
  .case-title {
    font-size: clamp(21px, 2.4vw, 26px);
    line-height: 1.25;
    margin: 0 0 10px;
    font-weight: 600;
    letter-spacing: -0.015em;
  }
  .summary {
    color: var(--muted);
    margin: 0 0 20px;
  }
  .timeline {
    list-style: none;
    margin: 0 0 22px;
    padding: 0;
    font-size: 14px;
  }
  .timeline li {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 12px;
    padding: 10px 0;
    border-top: 1px solid var(--line);
    color: var(--muted);
  }
  .timeline .t {
    color: var(--text);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
  .timeline b {
    color: var(--text);
    font-weight: 500;
  }
  .timeline b.neg {
    color: var(--error);
  }
  .officials {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 10px;
  }
  .off {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 12px 14px;
    border-radius: var(--radius-sm);
    background: var(--bg-2);
    transition: background 0.15s;
  }
  .off:hover {
    background: var(--pill-hover);
  }
  .off-name {
    font-weight: 600;
  }
  .off-call {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    font-size: 12.5px;
  }
  .reactions {
    padding: 24px;
    border-left: 1px solid var(--line);
    background: var(--bg-2);
  }
  .reactions h3 {
    margin: 0 0 14px;
  }
  .reactions ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 16px;
  }
  blockquote {
    margin: 0 0 4px;
    font-size: 15px;
    line-height: 1.5;
    color: var(--text);
  }
  blockquote.para {
    color: var(--muted);
    font-size: 14px;
  }
  cite {
    font-style: normal;
    font-size: 13px;
  }
  cite b {
    font-weight: 600;
  }
  .pulse {
    margin-top: 22px;
  }
  .pulse h3 {
    margin: 0 0 10px;
  }
  .thread {
    display: flex;
    flex-direction: column;
    gap: 1px;
