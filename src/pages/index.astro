---
import Base from '../layouts/Base.astro';
import ClubBadge from '../components/ClubBadge.astro';
import Heat from '../components/Heat.astro';
import IncidentRow from '../components/IncidentRow.astro';
import LastFive from '../components/LastFive.astro';
import Verdict from '../components/Verdict.astro';
import {
  OUTCOME_LABEL,
  SOURCE_LABEL,
  benefitMatrix,
  bestOfficials,
  club,
  clubStats,
  formatDate,
  href,
  incidents,
  isConfirmed,
  official,
  officialStats,
  panelAccuracy,
  pct,
  seasonFiles,
  seasonTallies,
  verdictOf,
  worstOfficials,
} from '../lib/data';

const featured = incidents.find((i) => i.featured) ?? incidents[0];
const stats = officialStats();
const worst = worstOfficials(stats).slice(0, 6);
// AVARs inherit the VAR's verdict, so rank only the people who made the calls.
// Require a real sample before crowning anyone, and rank only people who made the calls (AVARs inherit the VAR's verdict).
const best = bestOfficials(stats.filter((s) => s.roles.referee + s.roles.var > 0 && s.correct + s.errors >= 8)).slice(0, 6);
const ledger = clubStats().filter((c) => c.errorsFor + c.errorsAgainst > 0);
const maxAbs = Math.max(1, ...ledger.map((c) => Math.max(c.errorsFor, c.errorsAgainst)));
const matrix = benefitMatrix();

const errorCount = incidents.filter((i) => verdictOf(i) === 'error').length;
const confirmedErrors = incidents.filter((i) => verdictOf(i) === 'error' && isConfirmed(i)).length;
const decidingErrors = incidents.filter((i) => verdictOf(i) === 'error' && i.impact === 'match-deciding').length;

const featuredPeople = (['referee', 'var', 'avar'] as const)
  .map((role) => ({ role, id: featured.officials[role] }))
  .filter((p): p is { role: 'referee' | 'var' | 'avar'; id: string } => Boolean(p.id))
  .map((p) => ({ ...p, stats: stats.find((s) => s.official.id === p.id)! }));
const discussion = featured.sources.filter((s) => s.kind === 'discussion');
const reporting = featured.sources.filter((s) => s.kind !== 'discussion');

const kmi = seasonTallies.find((t) => t.season === '2025-26');
const kmiRows = kmi
  ? kmi.var
      .map((v) => {
        const r = kmi.referee.find((x) => x.club === v.club) ?? { for: 0, against: 0 };
        return { club: v.club, varNet: v.for - v.against, refNet: r.for - r.against, net: v.for - v.against + r.for - r.against, for: v.for + r.for, against: v.against + r.against };
      })
      .sort((a, b) => b.net - a.net || b.for - a.for)
  : [];
const kmiMax = Math.max(1, ...kmiRows.map((r) => Math.abs(r.net)));
const roleLabel = { referee: 'Referee', var: 'VAR', avar: 'Assistant VAR' };
const current = seasonFiles.map((f) => f.season).sort().reverse()[0];
const currentFile = seasonFiles.find((f) => f.season === current)!;
const seasonAcc = panelAccuracy(current);
const seasonIncidents = incidents.filter((i) => i.season === current);
const lastWeek = Math.max(...currentFile.matches.map((m) => m.matchweek));
---

<Base>
  <!-- ─── Hero ─── -->
  <section class="hero">
    <div class="mesh" aria-hidden="true"></div>
    <div class="wrap bento">
      <div class="tile t-intro">
        <span class="chip"><span class="live"></span>{current.replace('-', '–')} · matchweek {lastWeek} tracked</span>
        <h1 class="display">Every VAR call.<br /><span class="mark">On the record.</span></h1>
        <p class="lede">
          The open ledger of Premier League refereeing decisions. See who got it wrong, who benefited, and how every
          official really rates, backed by the KMI panel's own rulings.
        </p>
        <div class="cta">
          <a class="btn btn-primary" href="#leaderboard">See the leaderboard</a>
          <a class="btn" href={href(`/season/${current}/`)}>Open the season →</a>
        </div>
      </div>

      <a class="tile t-case" href={href(`/incidents/${featured.id}/`)}>
        <span class="t-case-top">
          <span class="eyebrow on-dark">Case of the week</span>
          <Heat level={featured.controversy} />
        </span>
        <span class="mini-score">
          <ClubBadge id={featured.home} size={40} />
          <span class="display ms-num">{featured.score.replace('-', '–')}</span>
          <ClubBadge id={featured.away} size={40} />
        </span>
        <span class="t-case-title">{featured.title}</span>
        <span class="t-case-people">
          {featuredPeople.map((p) => (
            <span class:list={['tp', { bad: (p.role === 'referee' ? featured.calls.referee : featured.calls.var) === 'error' }]}>
              <span class="tp-role">{roleLabel[p.role]}</span>
              {official(p.id).name}
            </span>
          ))}
        </span>
        <span class="t-case-foot">
          <span class="err-chip">
            <span class:list={['x', verdictOf(featured)]}>{verdictOf(featured) === 'error' ? '✕' : '✓'}</span>
            {verdictOf(featured) === 'error' ? 'Error' : 'Correct'} · {SOURCE_LABEL[featured.verdictSource].toLowerCase()}
          </span>
          <span class="go">→</span>
        </span>
      </a>

      <div class="tile t-gauge">
        <span class="gauge" style={`--p:${Math.round((seasonAcc.onField ?? 0) * 100)}`}>
          <span class="gauge-in">
            <b class="display">{pct(seasonAcc.onField)}</b>
          </span>
        </span>
        <span class="g-label">Right on the pitch</span>
        <span class="g-sub dim">{pct(seasonAcc.final)} after VAR · KMI panel</span>
      </div>

      {
        worst[0] && (
          <a class="tile t-shame" href={href(`/officials/${worst[0].official.id}/`)}>
            <span class="eyebrow">Most damaging official</span>
            <span class="sh-name display">{worst[0].official.name}</span>
            <span class="dim sh-meta">
              {worst[0].errors} errors · {worst[0].matchDeciding} match-deciding · helped{' '}
              {[...worst[0].benefitedBy.keys()].map((c) => club(c).short).join(', ')}
            </span>
            <span class="sh-row">
              <span class="sh-score">
                <b class="display neg">{worst[0].damage % 1 ? worst[0].damage.toFixed(1) : worst[0].damage}</b>
                <span class="dim">damage</span>
              </span>
              <LastFive decisions={worst[0].decisions} size={16} link={false} />
            </span>
          </a>
        )
      }

      <div class="tile t-stat"><span class="eyebrow">Matches tracked</span><b class="display">{seasonFiles.reduce((n, f) => n + f.matches.length, 0)}</b></div>
      <div class="tile t-stat"><span class="eyebrow">Key decisions</span><b class="display">{incidents.length}</b></div>
      <div class="tile t-stat"><span class="eyebrow">Officially admitted errors</span><b class="display">{confirmedErrors}</b></div>
      <div class="tile t-stat t-red"><span class="eyebrow">Match-deciding errors</span><b class="display">{decidingErrors}</b></div>
    </div>
  </section>

  <div class="ticker" aria-label="Latest decisions">
    <div class="ticker-track">
      {
        [0, 1].map((copy) => (
          <ul aria-hidden={copy === 1 ? 'true' : undefined}>
            {incidents.slice(0, 14).map((i) => (
              <li>
                <a href={href(`/incidents/${i.id}/`)} tabindex={copy === 1 ? -1 : undefined}>
                  <span class:list={['tk-dot', verdictOf(i)]} />
                  <span class="tk-match mono">
                    {club(i.home).short} {i.score.replace('-', '–')} {club(i.away).short}
                  </span>
                  <span class="tk-title">{i.title}</span>
                </a>
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>

  <!-- ─── Featured case ─── -->
  <section class="wrap feature-wrap reveal">
    <article class="case panel">
      <header class="case-head">
        <div class="case-label">
          <span class="eyebrow">Case file · this week</span>
          <Verdict verdict={verdictOf(featured)} size="lg" />
          <span class="tag">{SOURCE_LABEL[featured.verdictSource]}</span>
        </div>
        <Heat level={featured.controversy} showLabel />
      </header>

      <div class="scoreboard">
        <div class="team">
          <ClubBadge id={featured.home} size={64} link />
          <span class="team-name">{club(featured.home).name}</span>
        </div>
        <div class="score-mid">
          <div class="score">{featured.score.replace('-', ' – ')}</div>
          <div class="eyebrow">{formatDate(featured.date, { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' })}</div>
        </div>
        <div class="team">
          <ClubBadge id={featured.away} size={64} link />
          <span class="team-name">{club(featured.away).name}</span>
        </div>
      </div>

      <div class="case-grid">
        <div class="case-main">
          <h2 class="case-title">{featured.title}</h2>
          <p class="summary">{featured.summary}</p>

          <ol class="timeline">
            <li><span class="t">{featured.minute}</span><span>On the pitch: <b>{featured.onField}</b></span></li>
            <li><span class="t">VAR</span><span><b class:list={{ neg: verdictOf(featured) === 'error' }}>{OUTCOME_LABEL[featured.varOutcome]}</b></span></li>
            {featured.consequences.slice(0, 2).map((c) => <li><span class="t">After</span><span>{c}</span></li>)}
          </ol>

          <div class="officials">
            {
              featuredPeople.map((p) => (
                <a class="off" href={href(`/officials/${p.id}/`)}>
                  <span class="eyebrow">{roleLabel[p.role]}</span>
                  <span class="off-name">{official(p.id).name}</span>
                  <span class="off-call">
                    <Verdict verdict={p.role === 'referee' ? featured.calls.referee : featured.calls.var} size="sm" />
                    <span class="dim">
                      {p.stats.errors} err · {pct(p.stats.accuracy)} acc
                    </span>
                  </span>
                </a>
              ))
            }
          </div>

          <div class="pulse">
            <h3 class="eyebrow">Where fans are arguing</h3>
            {
              discussion.map((d) => (
                <a class="thread" href={d.url} rel="noopener" target="_blank">
                  <span class="thread-src">{d.publisher}</span>
                  <span>{d.title}</span>
                </a>
              ))
            }
          </div>
        </div>

        <aside class="reactions">
          <h3 class="eyebrow">The reaction</h3>
          <ul>
            {
              featured.reactions.map((r) => (
                <li>
                  <blockquote class:list={{ para: r.paraphrased }}>{r.paraphrased ? r.quote : `“${r.quote}”`}</blockquote>
                  <cite>
                    <b>{r.who}</b>
                    {r.role && <span class="dim"> · {r.role}</span>}
                  </cite>
                </li>
              ))
            }
          </ul>
        </aside>
      </div>
      <footer class="case-foot">
        <span class="dim">Sources:</span>
        {reporting.map((s) => <a href={s.url} rel="noopener" target="_blank">{s.publisher}</a>)}
        <a class="link-arrow" href={href(`/incidents/${featured.id}/`)}>Full case file →</a>
      </footer>
    </article>
  </section>

  <!-- ─── Officials leaderboard ─── -->
  <section class="wrap section reveal" id="leaderboard">
    <div class="section-head">
      <div>
        <span class="eyebrow">The leaderboard</span>
        <h2 class="display">Officials</h2>
        <p>
          Each official is rated only on the calls they were responsible for. Errors are weighted by impact: a
          match-deciding error costs 3, a minor one costs 1. The AVAR shares the VAR's verdict.
        </p>
      </div>
      <a class="link-arrow" href={href('/officials/')}>All officials →</a>
    </div>

    <div class="boards">
      <div class="board panel">
        <div class="board-head">
          <h3>Hall of shame</h3>
          <span class="eyebrow">by damage score</span>
        </div>
        <ol>
          {
            worst.map((s, n) => (
              <li>
                <a href={href(`/officials/${s.official.id}/`)} class="lb-row">
                  <span class="rank">{String(n + 1).padStart(2, '0')}</span>
                  <span class="lb-name">
                    <b>{s.official.name}</b>
                    <span class="dim">
                      {s.errors} error{s.errors === 1 ? '' : 's'}
                      {s.matchDeciding > 0 && <span class="neg"> · {s.matchDeciding} match-deciding</span>}
                    </span>
                  </span>
                  <span class="lb-benef">
                    {[...s.benefitedBy.entries()].sort((a, b) => b[1] - a[1]).slice(0, 3).map(([c]) => <ClubBadge id={c} size={22} />)}
                  </span>
                  <span class="lb-score neg">{s.damage % 1 ? s.damage.toFixed(1) : s.damage}</span>
                </a>
              </li>
            ))
          }
        </ol>
        <p class="board-note dim">Badges show the clubs that benefited from that official's errors.</p>
      </div>

      <div class="board panel">
        <div class="board-head">
          <h3>Clean sheet</h3>
          <span class="eyebrow">by accuracy</span>
        </div>
        <ol>
          {
            best.map((s, n) => (
              <li>
                <a href={href(`/officials/${s.official.id}/`)} class="lb-row">
                  <span class="rank">{String(n + 1).padStart(2, '0')}</span>
                  <span class="lb-name">
                    <b>{s.official.name}</b>
                    <span class="dim">
                      {s.correct} correct · {s.errors} wrong
                    </span>
                  </span>
                  <LastFive decisions={s.decisions} size={18} link={false} />
                  <span class="lb-score pos">{pct(s.accuracy)}</span>
                </a>
              </li>
            ))
          }
        </ol>
        <p class="board-note dim">Minimum 8 judged calls. Rated on referee and VAR decisions across both seasons.</p>
      </div>
    </div>
  </section>

  <!-- ─── Club ledger ─── -->
  <section class="wrap section tight reveal">
    <div class="section-head">
      <div>
        <span class="eyebrow">Who benefits</span>
        <h2 class="display">Club ledger</h2>
        <p>Errors that went for and against each club across every incident on file. Green means the club gained.</p>
      </div>
      <a class="link-arrow" href={href('/clubs/')}>All clubs →</a>
    </div>
    <div class="ledger panel">
      <div class="ledger-legend dim"><span>◀ against</span><span>for ▶</span></div>
      {
        ledger.map((c) => (
          <a class="led-row" href={href(`/clubs/${c.club.id}/`)}>
            <span class="led-club">
              <ClubBadge id={c.club.id} size={26} />
              <span>{c.club.name}</span>
            </span>
            <span class="led-bars">
              <span class="half left">
                <span class="bar neg-bar" style={`width:${(c.errorsAgainst / maxAbs) * 100}%`}>
                  {c.errorsAgainst > 0 && <i>{c.errorsAgainst}</i>}
                </span>
              </span>
              <span class="half right">
                <span class="bar pos-bar" style={`width:${(c.errorsFor / maxAbs) * 100}%`}>
                  {c.errorsFor > 0 && <i>{c.errorsFor}</i>}
                </span>
              </span>
            </span>
            <span class:list={['led-net', c.net > 0 ? 'pos' : c.net < 0 ? 'neg' : 'dim']}>
              {c.net > 0 ? `+${c.net}` : c.net}
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- ─── Heatmap ─── -->
  <section class="wrap section tight reveal">
    <div class="section-head">
      <div>
        <span class="eyebrow">Patterns</span>
        <h2 class="display">Who their mistakes helped</h2>
        <p>
          Net effect of each official's errors on each club. Green cells mean the club gained and red cells mean it lost.
          A pattern here is a reason to look closer, not proof of bias.
        </p>
      </div>
    </div>
    <div class="panel heat-wrap table-scroll">
      <table class="heatmap">
        <thead>
          <tr>
            <th></th>
            {matrix.clubIds.map((c) => <th><ClubBadge id={c} size={26} /></th>)}
          </tr>
        </thead>
        <tbody>
          {
            matrix.rows.map((r) => (
              <tr>
                <th scope="row">
                  <a href={href(`/officials/${r.stats.official.id}/`)}>{r.stats.official.name}</a>
                </th>
                {r.cells.map((v, n) => (
                  <td
                    class:list={['cell', v > 0 ? 'up' : v < 0 ? 'down' : '']}
                    style={`--a:${Math.min(1, Math.abs(v) / 2)}`}
                    title={`${r.stats.official.name} → ${club(matrix.clubIds[n]).name}: ${v > 0 ? '+' : ''}${v}`}
                  >
                    {v !== 0 ? (v > 0 ? `+${v}` : v) : ''}
                  </td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <!-- ─── Latest incidents ─── -->
  <section class="wrap section tight reveal">
    <div class="section-head">
      <div>
        <span class="eyebrow">The feed</span>
        <h2 class="display">Latest incidents</h2>
      </div>
      <a class="link-arrow" href={href('/incidents/')}>All {incidents.length} incidents →</a>
    </div>
    <div class="panel feed">
      {incidents.slice(0, 8).map((i) => <IncidentRow incident={i} />)}
    </div>
  </section>

  <!-- ─── KMI official season table ─── -->
  {
    kmi && (
      <section class="wrap section tight reveal">
        <div class="section-head">
          <div>
            <span class="eyebrow">Official record · 2025-26</span>
            <h2 class="display">What the panel ruled</h2>
            <p>
              The Premier League's Key Match Incidents panel reviews every contentious call. These are its final
              2025-26 tallies of VAR and referee errors for and against each club.
            </p>
          </div>
          <a class="link-arrow" href={href('/clubs/#kmi')}>Full table →</a>
        </div>
        <div class="panel kmi">
          {kmiRows.map((r) => (
            <a class="kmi-row" href={href(`/clubs/${r.club}/`)}>
              <span class="led-club">
                <ClubBadge id={r.club} size={24} />
                <span>{club(r.club).name}</span>
              </span>
              <span class="kmi-track">
                <span class="kmi-zero" />
                <span
                  class:list={['kmi-bar', r.net >= 0 ? 'up' : 'down']}
                  style={`--w:${(Math.abs(r.net) / kmiMax) * 50}%`}
                />
              </span>
              <span class="kmi-split dim">
                {r.for}↑ {r.against}↓
              </span>
              <span class:list={['led-net', r.net > 0 ? 'pos' : r.net < 0 ? 'neg' : 'dim']}>{r.net > 0 ? `+${r.net}` : r.net}</span>
            </a>
          ))}
          <p class="board-note dim">
            Source: <a href={kmi.sources[0].url}>{kmi.sources[0].publisher}</a>. Combined VAR and on-field errors.
          </p>
        </div>
      </section>
    )
  }

  <!-- ─── Contribute ─── -->
  <section class="wrap section reveal">
    <div class="join panel">
      <div>
        <span class="eyebrow">Open source · open data</span>
        <h2 class="display">Saw a howler? Put it on the record.</h2>
        <p class="muted">
          Every incident is a small JSON file in a public GitHub repo. Submit one through a guided form or open a pull
          request. Every entry needs a source, and panel rulings update verdicts as they come in.
        </p>
      </div>
      <div class="join-cta">
        <a class="btn btn-primary" href={href('/contribute/')}>Log an incident</a>
        <a class="btn" href={href('/method/')}>How verdicts work</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    position: relative;
    padding-block: clamp(28px, 5vw, 56px) 28px;
    overflow: hidden;
  }
  .mesh {
    position: absolute;
    inset: -20% -10% auto;
    height: 720px;
    background:
      radial-gradient(40% 50% at 20% 30%, var(--mesh-1), transparent 70%),
      radial-gradient(35% 45% at 75% 20%, var(--mesh-2), transparent 70%),
      radial-gradient(30% 40% at 60% 80%, var(--mesh-3), transparent 70%);
    filter: blur(20px);
    pointer-events: none;
  }
  .bento {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 14px;
  }
  .tile {
    position: relative;
    border-radius: var(--radius);
    background: var(--panel);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
    padding: 22px;
    transition:
      transform 0.35s var(--ease),
      box-shadow 0.35s var(--ease);
  }
  a.tile:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lg);
  }
  .t-intro {
    grid-column: span 7;
    grid-row: span 2;
    padding: clamp(24px, 4vw, 44px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: color-mix(in srgb, var(--panel) 78%, transparent);
    backdrop-filter: blur(8px);
  }
  .chip {
    align-self: start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px 6px 10px;
    border-radius: 999px;
    background: var(--panel);
    border: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--muted);
  }
  .live {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--correct);
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--correct) 60%, transparent);
    animation: ping 2s infinite;
  }
  @keyframes ping {
    70% {
      box-shadow: 0 0 0 7px transparent;
    }
  }
  h1 {
    font-size: clamp(44px, 5.8vw, 80px);
    margin: 22px 0 18px;
  }
  .mark {
    background: linear-gradient(transparent 62%, var(--volt) 62% 92%, transparent 92%);
    padding-inline: 2px;
  }
  :global([data-theme='dark']) .mark {
    background: none;
    color: var(--volt);
  }
  .lede {
    max-width: 52ch;
    font-size: clamp(16px, 1.5vw, 18px);
    color: var(--muted);
    margin: 0;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
  }

  .t-case {
    grid-column: span 5;
    display: flex;
    flex-direction: column;
    gap: 14px;
    background:
      radial-gradient(120% 90% at 100% 0%, rgba(229, 72, 77, 0.35), transparent 60%),
      radial-gradient(80% 80% at 0% 100%, rgba(79, 70, 229, 0.35), transparent 60%),
      #111113;
    color: #f2f2f3;
    border-color: #111113;
  }
  .t-case-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .on-dark {
    color: rgba(255, 255, 255, 0.6);
  }
  .mini-score {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .ms-num {
    font-size: 52px;
    font-variant-numeric: tabular-nums;
  }
  .t-case-title {
    font-size: 18px;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.01em;
