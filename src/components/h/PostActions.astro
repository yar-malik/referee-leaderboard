---
// Reddit-style action row: up/down vote, comments, share, save. Hydrated by h-client.
import { postUrl, type Post } from '../../lib/data';

interface Props {
  post: Post;
  /** On the post page the comments button scrolls to the thread instead of navigating. */
  onPostPage?: boolean;
}
const { post, onPostPage = false } = Astro.props;
const url = postUrl(post);
---

<div class="pa" data-actions={post.id}>
  <div class="pa-vote" data-post-vote={post.id}>
    <button type="button" class="pa-up" data-dir="1" aria-label="Upvote">
      <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M10 3 3 11h4.5v6h5v-6H17z"></path></svg>
    </button>
    <span class="pa-score" data-score>Vote</span>
    <button type="button" class="pa-down" data-dir="-1" aria-label="Downvote">
      <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M10 17 3 9h4.5V3h5v6H17z"></path></svg>
    </button>
  </div>
  <a class="pa-btn" href={onPostPage ? '#comments' : `${url}#comments`}>
    <svg viewBox="0 0 20 20" width="17" height="17" aria-hidden="true"><path d="M4 4h12a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H9l-4 3v-3H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1z"></path></svg>
    <span data-comments>Comments</span>
  </a>
  <button type="button" class="pa-btn" data-share={url} data-title={post.title}>
    <svg viewBox="0 0 20 20" width="17" height="17" aria-hidden="true"><path d="M13 5l4 4-4 4M17 9H9a5 5 0 0 0-5 5v1"></path></svg>
    <span data-share-label>Share</span>
  </button>
  <button type="button" class="pa-btn" data-save={post.id}>
    <svg viewBox="0 0 20 20" width="17" height="17" aria-hidden="true"><path d="M5 3h10v14l-5-3.5L5 17z"></path></svg>
    <span data-save-label>Save</span>
  </button>
</div>

<style>
  .pa {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
  }
  .pa-vote {
    display: inline-flex;
    align-items: center;
    height: 34px;
    border-radius: 999px;
    background: var(--pill);
  }
  .pa-vote button {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
  }
  .pa-vote svg,
  .pa-btn svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .pa-up:hover {
    color: #ff4500;
    background: rgba(255, 69, 0, 0.1);
  }
  .pa-down:hover {
    color: #6a5cff;
    background: rgba(106, 92, 255, 0.1);
  }
  .pa-score {
    min-width: 22px;
    font-size: 13px;
    font-weight: 700;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }
  .pa-vote:global(.up) {
    background: #ff4500;
    color: #fff;
  }
  .pa-vote:global(.down) {
    background: #6a5cff;
    color: #fff;
  }
  .pa-vote:global(.up) button,
  .pa-vote:global(.down) button {
    color: #fff;
  }
  .pa-vote:global(.up) .pa-up svg,
  .pa-vote:global(.down) .pa-down svg {
    fill: #fff;
  }
  .pa-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 34px;
    padding: 0 12px;
    border: 0;
    border-radius: 999px;
    background: var(--pill);
    color: var(--text);
    font: inherit;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
  }
  .pa-btn:hover {
    background: var(--pill-hover);
  }
  @media (max-width: 600px) {
    .pa-btn {
      padding: 0 10px;
    }
    [data-share] span,
    [data-save] span {
      display: none;
    }
  }
  .pa-btn:global(.saved) svg {
    fill: currentColor;
  }
</style>
